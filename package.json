{
  "name": "exosquad",
  "private": true,
  "version": "0.1.0",
  "description": "Foreign-product intelligence and supply network for Bangladesh",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @exosquad/database generate",
    "db:migrate": "pnpm --filter @exosquad/database migrate:deploy",
    "db:migrate:dev": "pnpm --filter @exosquad/database migrate:dev",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "eslint": "^9.15.0",
    "@eslint/js": "^9.15.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5",
    "@types/node": "^22.9.0"
  }
}
