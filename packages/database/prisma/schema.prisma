// =============================================================================
// EXOSQUAD — Prisma Schema
// =============================================================================
// Phase 1: Foundation tables (multi-tenancy, auth, sources, jobs, connections)
// Phase 2: Ingestion infrastructure (observations, raw responses, checkpoints)
// Phase 3: Canonical data model (brands, categories, product identity,
//          normalization errors, sellers, suppliers, manufacturers)
// Phase 4: Identity resolution (relationships, decisions, conflicts,
//          candidates, merge history, attributes, source reliability)
// Phase 5: Organization & commercial entity identity resolution
// Phase 6: Evidence & Provenance Graph (evidence, claims, conflicts,
//          calculations, provenance edges, freshness)
// Phase 7: Demand & Trend Intelligence (demand signals, demand calculations)
// Phase 8: Decision Intelligence & Reseller Opportunity Engine
// Phase 8 (Original): Authenticity Intelligence
// Phase 9: Supply-Chain Tracing & Provenance Graph Engine
// Phase 10: Logistics & Routing Intelligence
// Phase 11: Landed Cost, Pricing & Margin Intelligence
// Phase 12: Product Opportunity, Competition & Reseller Viability Intelligence
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// MULTI-TENANCY
// =============================================================================

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("active") // active | suspended | cancelled
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  sources           Source[]
  apiConnections    ApiConnection[]
  products          Product[]
  jobs              Job[]
  auditLogs         AuditLog[]
  brands            Brand[]
  categories        Category[]
  sellers           Seller[]
  suppliers         Supplier[]
  manufacturers     Manufacturer[]
  organizations     Organization[]
  // Phase 6: Evidence & Provenance
  evidence          Evidence[]
  claims            Claim[]
  evidenceConflicts EvidenceConflict[]
  calculations      Calculation[]
  provenanceEdges   ProvenanceEdge[]
  // Phase 7: Demand & Trend Intelligence
  demandSignals     DemandSignal[]
  demandCalculations DemandCalculation[]
  // Phase 8: Decision Intelligence & Reseller Opportunity Engine
  opportunities     Opportunity[]
  // Phase 8 (Original Roadmap): Authenticity Intelligence
  authenticityAssessments AuthenticityAssessment[]
  // Phase 9: Supply-Chain Tracing & Provenance Graph
  supplyChainNodes          SupplyChainNode[]
  supplyChainEdges          SupplyChainEdge[]
  supplyChainObservations   SupplyChainObservation[]
  supplyChainEvidenceLinks  SupplyChainEvidenceLink[]
  supplyChainConflicts      SupplyChainConflict[]
  supplyChainAssessments    SupplyChainAssessment[]
  supplyChainVerifications  SupplyChainVerification[]
  supplyChainClaims         SupplyChainClaim[]
  supplyChainAnomalies      SupplyChainAnomaly[]
  // Phase 10: Logistics & Routing Intelligence
  logisticsNodes            LogisticsNode[]
  logisticsLegs             LogisticsLeg[]
  logisticsRoutes           LogisticsRoute[]
  logisticsObservations      LogisticsObservation[]
  logisticsEvidenceLinks    LogisticsEvidenceLink[]
  logisticsConflicts        LogisticsConflict[]
  logisticsAssessments      LogisticsAssessment[]
  logisticsRisks            LogisticsRisk[]
  logisticsAnomalies        LogisticsAnomaly[]
  // Phase 11: Landed Cost, Pricing & Margin Intelligence
  priceObservations         PriceObservation[]
  costComponents            CostComponent[]
  landedCostCalculations    LandedCostCalculation[]
  pricingScenarios          PricingScenario[]
  marketPriceSnapshots      MarketPriceSnapshot[]
  pricingRisks              PricingRisk[]
  pricingAssessments        PricingAssessment[]
  // Phase 12: Product Opportunity, Competition & Reseller Viability
  competitorObservations      CompetitorObservation[]
  competitorSnapshots         CompetitorSnapshot[]
  demandOpportunitySnapshots  DemandOpportunitySnapshot[]
  productOppSignals           ProductOppSignal[]
  productOppRisks             ProductOppRisk[]
  resellerViabilityAssessments ResellerViabilityAssessment[]
  // Phase 13: Supplier Discovery, Sourcing & Procurement Intelligence
  supplierSourcingAssessments   SupplierSourcingAssessment[]
  supplierProductMatches         SupplierProductMatch[]
  sourcingOptionRecords          SourcingOptionRecord[]
  procurementViabilityRecords    ProcurementViabilityRecord[]
  supplierContactEvidence        SupplierContactEvidence[]
  sourcingConstraintRecords      SourcingConstraintRecord[]
  supplierComparisonSnapshots    SupplierComparisonSnapshot[]
  // Phase 14: AI Research & Reasoning Engine
  researchRequests              ResearchRequest[]
  researchSubQuestions          ResearchSubQuestion[]
  researchEvidenceItems         ResearchEvidenceItem[]
  researchContradictions        ResearchContradiction[]
  researchHypotheses            ResearchHypothesis[]
  researchGaps                  ResearchGap[]
  researchResults               ResearchResult[]
  // Phase 15: Supplier Outreach / Sourcing Intelligence
  outreachCampaigns             OutreachCampaign[]
  outreachs                     Outreach[]
  outreachMessages              OutreachMessage[]
  outreachResponses             OutreachResponse[]
  outreachExtractedFields       OutreachExtractedField[]
  outreachFollowups             OutreachFollowup[]
  outreachQualifications        OutreachQualification[]
  outreachThreadEvents          OutreachThreadEvent[]
  outreachAuditEntries          OutreachAuditEntry[]
  outreachTemplates             OutreachTemplate[]

  @@map("tenants")
}

// =============================================================================
// AUTHENTICATION & AUTHORIZATION
// =============================================================================

model User {
  id                   String    @id @default(cuid())
  tenantId             String
  email                String
  passwordHash         String
  name                 String?
  role                 String    @default("member") // owner | admin | member | viewer
  status               String    @default("active") // active | disabled
  lastLoginAt          DateTime?
  passwordResetToken   String?   // SHA-256 hash of raw reset token
  passwordResetExpiry  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// =============================================================================
// DATA SOURCES — configurable ingestion endpoints
// =============================================================================

model Source {
  id                String    @id @default(cuid())
  tenantId          String
  name              String
  type              String // web_scraper | api_connector | marketplace | social_signal | product_database
  connectorType     String // universal_api | custom_scraper | marketplace_adapter
  config            Json      @default("{}") // URL, auth, headers, mapping rules
  scheduleCron      String? // null = manual only
  status            String    @default("active") // active | paused | error | disabled
  lastRunAt         DateTime?
  lastSuccessAt     DateTime?
  lastError         String?
  // ─── Phase 2: Source health tracking ──────────────────────────────────
  healthStatus      String    @default("unknown") // unknown | healthy | degraded | unhealthy
  consecutiveErrors Int       @default(0)
  totalFetched      Int       @default(0)
  totalFailed       Int       @default(0)
  avgLatencyMs      Float?
  lastFetchedAt     DateTime?
  lastHealthyAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  observations Observation[]
  rawResponses RawResponse[]
  checkpoints  IngestionCheckpoint[]
  evidence     Evidence[]
  demandSignals DemandSignal[]
  supplyChainObservations SupplyChainObservation[]
  logisticsObservations   LogisticsObservation[]

  @@index([tenantId])
  @@index([status])
  @@index([healthStatus])
  @@map("sources")
}

// =============================================================================
// RAW OBSERVATIONS — immutable evidence from sources
// =============================================================================
// Phase 3: Enhanced with data quality tracking and entity references.
// Observations are NEVER overwritten — they are temporal snapshots.

model Observation {
  id                  String    @id @default(cuid())
  sourceId            String
  tenantId            String
  rawUrl              String?
  rawPayload          Json
  contentHash         String // SHA-256 of raw payload for dedup
  retrievedAt         DateTime // when the data was fetched from source
  observedAt          DateTime // when the data was observed/published
  parserVersion       String? // connector/parser version that processed this
  normalizationStatus String    @default("pending") // pending | normalized | failed | skipped | partial
  normalizedPayload   Json?
  normalizedAt        DateTime?
  // ─── Phase 3: Data quality & entity references ───────────────────────
  dataQuality         String    @default("unresolved") // valid | partial | ambiguous | invalid | unresolved
  // Resolved entity references (set after normalization)
  brandId             String?
  productId           String?
  productVariantId    String?
  createdAt           DateTime  @default(now())

  source              Source               @relation(fields: [sourceId], references: [id])
  brand               Brand?               @relation(fields: [brandId], references: [id])
  product             Product?             @relation("ObservationProduct", fields: [productId], references: [id])
  productVariant      ProductVariant?      @relation("ObservationVariant", fields: [productVariantId], references: [id])
  normalizationErrors NormalizationError[]
  evidence            Evidence[]

  @@unique([sourceId, contentHash]) // Atomic idempotency — prevents duplicate observations
  @@index([sourceId])
  @@index([tenantId])
  @@index([contentHash])
  @@index([normalizationStatus])
  @@index([retrievedAt])
  @@index([dataQuality])
  @@index([brandId])
  @@index([productId])
  @@map("observations")
}

// =============================================================================
// BRANDS — deterministic brand resolution
// =============================================================================

model Brand {
  id             String   @id @default(cuid())
  tenantId       String
  name           String // canonical brand name
  normalizedName String // lowercase, punctuation-normalized form
  searchKey      String // stripped search key for matching
  status         String   @default("active") // active | merged | deprecated
  mergedIntoId   String? // if merged, points to the canonical brand
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  aliases      BrandAlias[]
  products     Product[]
  observations Observation[]

  @@unique([tenantId, normalizedName])
  @@index([tenantId])
  @@index([searchKey])
  @@index([normalizedName])
  @@map("brands")
}

model BrandAlias {
  id              String   @id @default(cuid())
  brandId         String
  alias           String // the alias string
  normalizedAlias String // normalized form for matching
  searchKey       String // stripped search key
  source          String   @default("seed") // seed | source | manual | imported
  createdAt       DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id])

  @@unique([brandId, normalizedAlias])
  @@index([searchKey])
  @@index([normalizedAlias])
  @@map("brand_aliases")
}

// =============================================================================
// CATEGORIES — hierarchical product classification
// =============================================================================

model Category {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  normalizedName String
  parentId       String?
  level          Int      @default(0) // 0=root, 1=subcategory, etc.
  path           String   @default("") // e.g., "beauty/skincare/cleansers"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, normalizedName, parentId])
  @@index([tenantId])
  @@index([parentId])
  @@index([normalizedName])
  @@map("categories")
}

// =============================================================================
// PRODUCT IDENTITY — resolved entities with evidence chain
// =============================================================================
// Phase 3: Evolved with normalized fields, brand/category relations,
// and richer product metadata.

model Product {
  id              String   @id @default(cuid())
  tenantId        String
  name            String // best known display name
  normalizedName  String // text-normalized form
  searchKey       String   @default("") // stripped key for candidate blocking
  brandId         String?
  categoryId      String?
  description     String?
  countryOfOrigin String? // ISO 3166-1 alpha-2
  attributes      Json     @default("{}")
  confidence      Float    @default(0.0) // 0.0–1.0 resolution confidence
  status          String   @default("active") // active | merged | deprecated
  mergedIntoId    String? // if merged, points to canonical product
  identityStatus  String   @default("unresolved") // resolved | high_confidence | possible | ambiguous | conflict | unresolved | invalid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant              Tenant                 @relation(fields: [tenantId], references: [id])
  brand               Brand?                 @relation(fields: [brandId], references: [id])
  category            Category?              @relation(fields: [categoryId], references: [id])
  variants            ProductVariant[]
  identifiers         ProductIdentifier[]
  evidence            Evidence[]
  observations        Observation[]          @relation("ObservationProduct")
  // Phase 4: Identity resolution relations
  relationshipsAsFrom IdentityRelationship[] @relation("RelationshipFrom")
  relationshipsAsTo   IdentityRelationship[] @relation("RelationshipTo")
  decisionsAsFrom     IdentityDecision[]     @relation("DecisionFrom")
  decisionsAsTo       IdentityDecision[]     @relation("DecisionTo")
  conflictsAsEntity   IdentityConflict[]     @relation("ConflictEntity")
  candidatesAsFrom    IdentityCandidate[]    @relation("CandidateFrom")
  candidatesAsTo      IdentityCandidate[]    @relation("CandidateTo")
  mergeHistory        IdentityMergeHistory[] @relation("MergeEntity")
  productAttributes   ProductAttribute[]
  productSellers      ProductSeller[]
  productSuppliers    ProductSupplier[]
  // Phase 11: Landed Cost, Pricing & Margin Intelligence
  priceObservations      PriceObservation[]
  costComponents         CostComponent[]
  landedCostCalculations LandedCostCalculation[]
  pricingScenarios       PricingScenario[]
  marketPriceSnapshots   MarketPriceSnapshot[]
  // Phase 15: Supplier Outreach
  outreachCampaigns  OutreachCampaign[]
  outreachs          Outreach[]

  @@index([tenantId])
  @@index([brandId])
  @@index([categoryId])
  @@index([normalizedName])
  @@index([searchKey])
  @@index([identityStatus])
  @@map("products")
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  name            String?
  normalizedName  String?
  searchKey       String? // stripped key for matching
  sku             String?
  // ─── Phase 3: Pack structure & unit normalization ────────────────────
  packCount       Int? // number of items in pack (e.g., 6 in "6 x 236ml")
  perUnitQuantity Decimal? // per-unit quantity (e.g., 236.0)
  perUnitUnit     String? // per-unit canonical unit (e.g., "ml")
  totalQuantity   Decimal? // packCount * perUnitQuantity
  netQuantity     Decimal? // alias for total for simple (non-pack) products
  quantityUnit    String? // canonical unit: mg | g | kg | ml | l | unit | piece | etc.
  // ─── Phase 4: Variant attributes ────────────────────────────────────
  formulation     String?
  flavor          String?
  scent           String?
  concentration   String?
  strength        String?
  spf             String?
  ageGroup        String?
  genderTarget    String?
  color           String?
  modelVersion    String?
  // ─── Legacy fields (preserved for backward compat) ───────────────────
  packSize        String? // original pack size string
  volume          String?
  weight          String?
  weightUnit      String?
  size            String?
  attributes      Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product      Product       @relation(fields: [productId], references: [id])
  observations Observation[] @relation("ObservationVariant")

  @@index([productId])
  @@index([sku])
  @@index([normalizedName])
  @@index([searchKey])
  @@map("product_variants")
}

// =============================================================================
// PRODUCT IDENTIFIERS — GTIN, UPC, EAN, MPN, source-specific IDs
// =============================================================================

model ProductIdentifier {
  id         String   @id @default(cuid())
  productId  String
  tenantId   String
  type       String // gtin8 | gtin12 | gtin13 | gtin14 | upc | ean | mpn | source_product_id | sku
  value      String // the identifier value
  normalized String // normalized form (e.g., zero-padded GTIN-13)
  isValid    Boolean  @default(true)
  sourceId   String? // which source provided this identifier
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@unique([tenantId, type, normalized])
  @@index([productId])
  @@index([tenantId])
  @@index([type, normalized])
  @@index([normalized])
  @@map("product_identifiers")
}

// =============================================================================
// SELLERS — marketplace sellers, resellers, retailers
// =============================================================================

model Seller {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  normalizedName String
  searchKey      String   @default("")
  storefrontName String?
  legalName      String?
  sourceId       String?
  sourceSellerId String?
  url            String?
  domain         String?
  email          String?
  phone          String?
  country        String? // ISO 3166-1 alpha-2
  rating         Decimal?
  reviewCount    Int?
  status         String   @default("active")
  identityStatus String   @default("unresolved") // unresolved | resolved | high_confidence | possible | ambiguous | conflict
  organizationId String? // link to canonical organization
  attributes     Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  organization Organization?   @relation(fields: [organizationId], references: [id])
  productLinks ProductSeller[]

  @@unique([tenantId, sourceId, sourceSellerId])
  @@index([tenantId])
  @@index([normalizedName])
  @@index([searchKey])
  @@index([sourceId])
  @@index([domain])
  @@index([identityStatus])
  @@index([organizationId])
  @@map("sellers")
}

// =============================================================================
// SUPPLIERS — wholesale/distribution suppliers
// =============================================================================

model Supplier {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  normalizedName   String
  searchKey        String   @default("")
  legalName        String?
  tradingName      String?
  sourceId         String?
  sourceSupplierId String?
  country          String? // ISO 3166-1 alpha-2
  url              String?
  domain           String?
  email            String?
  phone            String?
  contactPerson    String?
  supplierRole     String? // manufacturer | distributor | wholesaler | authorized_distributor
  status           String   @default("active")
  identityStatus   String   @default("unresolved")
  organizationId   String? // link to canonical organization
  attributes       Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  organization Organization?     @relation(fields: [organizationId], references: [id])
  productLinks ProductSupplier[]
  // Phase 15: Supplier Outreach
  outreachs    Outreach[]

  @@unique([tenantId, sourceId, sourceSupplierId])
  @@index([tenantId])
  @@index([normalizedName])
  @@index([searchKey])
  @@index([domain])
  @@index([identityStatus])
  @@index([organizationId])
  @@map("suppliers")
}

// =============================================================================
// MANUFACTURERS — original product manufacturers
// =============================================================================

model Manufacturer {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  normalizedName String
  searchKey      String   @default("")
  legalName      String?
  tradingName    String?
  country        String? // ISO 3166-1 alpha-2
  url            String?
  domain         String?
  status         String   @default("active")
  identityStatus String   @default("unresolved")
  organizationId String? // link to canonical organization
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([tenantId, normalizedName])
  @@index([tenantId])
  @@index([normalizedName])
  @@index([searchKey])
  @@index([domain])
  @@index([identityStatus])
  @@index([organizationId])
  @@map("manufacturers")
}

// =============================================================================
// NORMALIZATION ERRORS — record-level failure tracking
// =============================================================================
// Malformed source records are tracked here, not silently discarded.
// Each error links to the source observation for provenance.

model NormalizationError {
  id              String   @id @default(cuid())
  tenantId        String
  observationId   String?
  sourceId        String?
  sourceRecordId  String? // record identifier from source if available
  failureCategory String // schema_validation | type_coercion | missing_required | duplicate | parse_error
  reason          String // human-readable error description
  rawRecord       Json? // reference to the problematic raw record
  createdAt       DateTime @default(now())

  observation Observation? @relation(fields: [observationId], references: [id])

  @@index([tenantId])
  @@index([observationId])
  @@index([sourceId])
  @@index([failureCategory])
  @@index([createdAt])
  @@map("normalization_errors")
}

// =============================================================================
// EVIDENCE & PROVENANCE — Phase 6: Immutable evidence with full provenance
// =============================================================================
// Evidence is NEVER silently overwritten. Each record is a temporal snapshot.
// Every evidence record traces back to source → raw response → observation.

model Evidence {
  id                       String    @id @default(cuid())
  tenantId                 String
  sourceId                 String?
  observationId            String?
  rawResponseId            String?
  evidenceType             String // PRODUCT_IDENTITY | PRICE | AVAILABILITY | SELLER_LISTING | SUPPLIER_IDENTITY | ORGANIZATION_IDENTITY | AUTHENTICITY | IDENTITY_DECISION | CALCULATION_INPUT | CALCULATION_RESULT | etc.
  title                    String
  description              String?
  sourceUrl                String?
  sourceRecordId           String? // identifier from the external source
  sourceField              String? // legacy field name
  sourcePath               String? // JSONPath or selector: $.products[17].price
  extractedValue           Json? // raw extracted value
  normalizedValue          Json? // normalized/canonical value
  valueType                String    @default("string") // string | number | boolean | json | currency | date
  confidence               Float     @default(0.0) // 0.0–1.0
  confidenceBasis          Json? // why this confidence: ["exact domain", "exact phone"]
  observedAt               DateTime  @default(now())
  retrievedAt              DateTime  @default(now())
  publishedAt              DateTime?
  validFrom                DateTime?
  validUntil               DateTime?
  freshness                String    @default("unknown") // live | fresh | aging | stale | unknown
  contentHash              String? // SHA-256 of extracted value for dedup
  extractionMethod         String? // manual | automated | ai_inference | parser
  parserVersion            String?
  normalizationVersion     String?
  fieldMappingVersion      String?
  extractionTimestamp      DateTime?
  status                   String    @default("active") // active | stale | superseded | retracted | invalid | conflicted
  observationStatus        String    @default("observed") // observed | inferred | probable | unknown
  method                   String    @default("automated") // manual | automated | ai_inference (legacy compat)
  methodVersion            String? // legacy compat
  verified                 Boolean   @default(false)
  verifiedAt               DateTime?
  // Entity references (polymorphic via entityType/entityId + optional typed FKs)
  entityType               String // product | supplier | source | brand | seller | manufacturer | organization | relationship | decision
  entityId                 String
  productId                String?
  // Links to specific decision/relationship models
  identityDecisionId       String?
  orgIdentityDecisionId    String?
  commercialRelationshipId String?
  productSellerId          String?
  productSupplierId        String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  tenant                   Tenant                  @relation(fields: [tenantId], references: [id])
  source                   Source?                 @relation(fields: [sourceId], references: [id])
  observation              Observation?            @relation(fields: [observationId], references: [id])
  rawResponse              RawResponse?            @relation(fields: [rawResponseId], references: [id])
  product                  Product?                @relation(fields: [productId], references: [id])
  identityDecision         IdentityDecision?       @relation("DecisionEvidence", fields: [identityDecisionId], references: [id])
  orgIdentityDecision      OrgIdentityDecision?    @relation("OrgDecisionEvidence", fields: [orgIdentityDecisionId], references: [id])
  commercialRelationship   CommercialRelationship? @relation("CommercialRelEvidence", fields: [commercialRelationshipId], references: [id])
  productSeller            ProductSeller?          @relation("ProductSellerEvidence", fields: [productSellerId], references: [id])
  productSupplier          ProductSupplier?        @relation("ProductSupplierEvidence", fields: [productSupplierId], references: [id])
  // Conflicts where this evidence is involved
  conflictsAsSupporting    EvidenceConflict[]      @relation("ConflictSupporting")
  conflictsAsContradicting EvidenceConflict[]      @relation("ConflictContradicting")
  // Calculation inputs/outputs
  calculationInputs        Calculation[]           @relation("CalculationInputEvidence")
  calculationOutputs       Calculation[]           @relation("CalculationOutputEvidence")
  // Provenance graph edges (logical references via sourceNodeId/targetNodeType)
  // Claims backed by this evidence
  claims                   Claim[]                 @relation("ClaimEvidence")
  // Phase 9: Supply-chain evidence links
  supplyChainObservations  SupplyChainObservation[]
  supplyChainEvidenceLinks SupplyChainEvidenceLink[] @relation("SCEvidenceLink")
  // Phase 10: Logistics evidence links
  logisticsObservations    LogisticsObservation[]
  logisticsEvidenceLinks   LogisticsEvidenceLink[] @relation("LogisticsEvidenceLink")

  @@unique([tenantId, sourceId, observationId, sourcePath, evidenceType, contentHash])
  @@index([tenantId])
  @@index([sourceId])
  @@index([observationId])
  @@index([rawResponseId])
  @@index([evidenceType])
  @@index([entityType, entityId])
  @@index([productId])
  @@index([status])
  @@index([freshness])
  @@index([confidence])
  @@index([contentHash])
  @@index([sourceRecordId])
  @@index([observedAt])
  @@index([validFrom, validUntil])
  @@index([identityDecisionId])
  @@index([orgIdentityDecisionId])
  @@index([commercialRelationshipId])
  @@index([productSellerId])
  @@index([productSupplierId])
  @@map("evidence")
}

// =============================================================================
// JOB QUEUE PERSISTENCE — track async job execution
// =============================================================================

model Job {
  id          String    @id @default(cuid())
  tenantId    String?
  queue       String // ingestion | normalization | analysis | outreach
  type        String // specific job type within queue
  payload     Json      @default("{}")
  status      String    @default("pending") // pending | running | completed | failed | cancelled
  priority    Int       @default(0)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  result      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([queue, status])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("jobs")
}

// =============================================================================
// UNIVERSAL API CONNECTIONS — provider-agnostic connector config
// =============================================================================

model ApiConnection {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  provider     String // user-defined label for the provider
  baseUrl      String
  authType     String // none | api_key | bearer | basic | oauth2
  authConfig   Json      @default("{}") // encrypted at rest in production
  headers      Json      @default("{}")
  rateLimit    Int? // requests per minute
  timeout      Int       @default(30000) // milliseconds
  retryConfig  Json      @default("{\"maxAttempts\":3,\"backoffMs\":1000}")
  status       String    @default("active") // active | error | disabled
  lastHealthAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("api_connections")
}

// =============================================================================
// AUDIT LOG — immutable record of all significant actions
// =============================================================================

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String // create | update | delete | login | logout | ingest | normalize | etc.
  resource   String // user | source | product | brand | etc.
  resourceId String?
  metadata   Json     @default("{}")
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// RAW RESPONSES — immutable HTTP response records with full provenance
// =============================================================================

model RawResponse {
  id              String   @id @default(cuid())
  sourceId        String
  connectionId    String?
  tenantId        String
  requestUrl      String
  requestMethod   String   @default("GET")
  requestHeaders  Json     @default("{}") // sanitized — no secrets
  httpStatus      Int
  responseHeaders Json     @default("{}")
  payloadRef      String? // reference to stored payload (future: object storage)
  payloadInline   Json? // inline payload for Phase 2 (migrate to ref later)
  contentHash     String // SHA-256 of raw response body
  latencyMs       Int
  recordCount     Int      @default(0)
  jobId           String?
  errorMessage    String?
  retrievedAt     DateTime @default(now())

  source   Source     @relation(fields: [sourceId], references: [id])
  evidence Evidence[]

  @@index([sourceId])
  @@index([tenantId])
  @@index([contentHash])
  @@index([retrievedAt])
  @@index([jobId])
  @@map("raw_responses")
}

// =============================================================================
// INGESTION CHECKPOINTS — resumable ingestion state per source
// =============================================================================

model IngestionCheckpoint {
  id                    String    @id @default(cuid())
  sourceId              String
  tenantId              String
  lastCursor            String? // cursor-based pagination state
  lastPage              Int? // page-based pagination state
  lastOffset            Int? // offset-based pagination state
  lastSyncTimestamp     DateTime? // for incremental sync
  totalRecordsProcessed Int       @default(0)
  lastBatchId           String? // idempotency key for last batch
  updatedAt             DateTime  @updatedAt

  source Source @relation(fields: [sourceId], references: [id])

  @@unique([sourceId])
  @@index([tenantId])
  @@map("ingestion_checkpoints")
}

// =============================================================================
// PHASE 4 — IDENTITY RESOLUTION
// =============================================================================

// ─── Identity Relationships ──────────────────────────────────────────────────
// Tracks relationships between products: EXACT_SKU, SAME_PRODUCT_VARIANT,
// SAME_PRODUCT_FAMILY, RELATED_PRODUCT, REPLACED_BY, SUPERSEDED_BY, etc.

model IdentityRelationship {
  id               String   @id @default(cuid())
  tenantId         String
  fromProductId    String
  toProductId      String
  relationshipType String // EXACT_SKU | SAME_PRODUCT_VARIANT | SAME_PRODUCT_FAMILY | RELATED_PRODUCT | REPLACED_BY | SUPERSEDED_BY
  confidence       Float    @default(0.0)
  evidenceJson     Json     @default("{}") // structured evidence
  status           String   @default("active") // active | superseded | reversed
  decisionId       String? // link to the decision that created this
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fromProduct Product @relation("RelationshipFrom", fields: [fromProductId], references: [id])
  toProduct   Product @relation("RelationshipTo", fields: [toProductId], references: [id])

  @@unique([tenantId, fromProductId, toProductId, relationshipType])
  @@index([tenantId])
  @@index([fromProductId])
  @@index([toProductId])
  @@index([relationshipType])
  @@index([status])
  @@map("identity_relationships")
}

// ─── Identity Decisions ──────────────────────────────────────────────────────
// Every identity decision with structured evidence and reasoning.

model IdentityDecision {
  id                String    @id @default(cuid())
  tenantId          String
  fromProductId     String
  toProductId       String
  decision          String // EXACT_MATCH | HIGH_CONFIDENCE_MATCH | POSSIBLE_MATCH | NO_MATCH | CONFLICT | UNRESOLVED
  confidence        Float     @default(0.0)
  reasons           Json      @default("[]") // array of reason strings
  // Structured matching dimensions
  identifierMatch   String? // exact | partial | none | conflict
  brandMatch        String? // exact | similar | none
  nameMatch         String? // exact | high | medium | low | none
  variantMatch      String? // exact | compatible | different | none
  quantityMatch     String? // exact | compatible | different | none
  packMatch         String? // exact | compatible | different | none
  countryMatch      String? // exact | compatible | different | none
  manufacturerMatch String? // exact | similar | none
  conflictState     String? // none | open | resolved | dismissed
  sourceReliability Float? // 0.0–1.0
  method            String    @default("deterministic") // deterministic | ai | manual | hybrid
  methodVersion     String? // version of the matching algorithm
  reviewerId        String? // null if automated
  reviewedAt        DateTime?
  reviewOverride    String?
  createdAt         DateTime  @default(now())

  fromProduct Product    @relation("DecisionFrom", fields: [fromProductId], references: [id])
  toProduct   Product    @relation("DecisionTo", fields: [toProductId], references: [id])
  evidence    Evidence[] @relation("DecisionEvidence")

  @@index([tenantId])
  @@index([fromProductId])
  @@index([toProductId])
  @@index([decision])
  @@index([method])
  @@index([createdAt])
  @@map("identity_decisions")
}

// ─── Identity Conflicts ──────────────────────────────────────────────────────
// Tracks conflicting identity evidence (same GTIN different names, etc.)

model IdentityConflict {
  id              String    @id @default(cuid())
  tenantId        String
  entityType      String // product | identifier | variant
  entityId        String
  conflictType    String // identifier_collision | name_conflict | variant_conflict | brand_conflict
  severity        String // low | medium | high | critical
  description     String
  conflictingData Json      @default("{}")
  status          String    @default("open") // open | resolved | dismissed | superseded
  resolvedAt      DateTime?
  resolvedBy      String?
  resolution      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  entity Product @relation("ConflictEntity", fields: [entityId], references: [id])

  @@index([tenantId])
  @@index([entityId])
  @@index([conflictType])
  @@index([status])
  @@index([severity])
  @@map("identity_conflicts")
}

// ─── Identity Candidates ─────────────────────────────────────────────────────
// Candidate pairs for identity resolution (blocking/indexing output).

model IdentityCandidate {
  id               String   @id @default(cuid())
  tenantId         String
  fromProductId    String
  toProductId      String
  status           String   @default("pending") // pending | processing | matched | rejected | ambiguous | failed
  priority         Int      @default(0)
  generationMethod String   @default("blocking") // blocking | identifier | manual | ai
  blockingKey      String? // the candidate key that generated this pair
  attempts         Int      @default(0)
  maxAttempts      Int      @default(3)
  lastError        String?
  resultJson       Json? // structured result from resolution
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fromProduct Product @relation("CandidateFrom", fields: [fromProductId], references: [id])
  toProduct   Product @relation("CandidateTo", fields: [toProductId], references: [id])

  @@unique([tenantId, fromProductId, toProductId])
  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@index([fromProductId])
  @@index([toProductId])
  @@map("identity_candidates")
}

// ─── Identity Merge History ──────────────────────────────────────────────────
// Immutable audit trail for merge/split/unmerge/override operations.

model IdentityMergeHistory {
  id            String    @id @default(cuid())
  tenantId      String
  entityId      String // the product involved
  action        String // merged | split | superseded | overridden
  fromProductId String? // source entity (for merge: the one being merged away)
  toProductId   String? // target entity (for merge: the canonical one)
  reason        String
  evidenceJson  Json      @default("{}")
  actorType     String    @default("system") // system | ai | manual
  actorId       String? // user ID if manual
  reversedAt    DateTime?
  reversedBy    String?
  reverseReason String?
  createdAt     DateTime  @default(now())

  entity Product @relation("MergeEntity", fields: [entityId], references: [id])

  @@index([tenantId])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@map("identity_merge_history")
}

// ─── Product Attributes ──────────────────────────────────────────────────────
// Extensible attribute model for product intelligence.

model ProductAttribute {
  id            String   @id @default(cuid())
  tenantId      String
  productId     String
  name          String // attribute name (e.g., "formulation", "sp f", "age_group")
  value         String // normalized value
  originalValue String // original value from source
  unit          String? // unit where relevant
  source        String   @default("extraction") // extraction | source | manual | ai
  confidence    Float    @default(1.0)
  observedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@unique([tenantId, productId, name, value])
  @@index([tenantId])
  @@index([productId])
  @@index([name])
  @@map("product_attributes")
}

// ─── Source Reliability ──────────────────────────────────────────────────────
// Source-level reliability metrics for identity resolution weighting.

model SourceReliability {
  id                    String   @id @default(cuid())
  tenantId              String
  sourceId              String   @unique
  identifierReliability Float    @default(0.5) // 0.0–1.0
  metadataReliability   Float    @default(0.5)
  historicalConsistency Float    @default(0.5)
  manufacturerAuthority Float    @default(0.0)
  marketplaceAuthority  Float    @default(0.0)
  totalObservations     Int      @default(0)
  confirmedMatches      Int      @default(0)
  conflicts             Int      @default(0)
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@index([tenantId])
  @@map("source_reliability")
}

// =============================================================================
// PHASE 5 — ORGANIZATION & COMMERCIAL ENTITY IDENTITY RESOLUTION
// =============================================================================

// ─── Organization ────────────────────────────────────────────────────────────
// Canonical commercial entity. A single organization may fulfil multiple roles
// (seller, supplier, distributor, manufacturer, etc.).

model Organization {
  id                 String   @id @default(cuid())
  tenantId           String
  canonicalName      String // best known display name
  normalizedName     String // lowercase, punctuation-normalized
  searchKey          String   @default("") // stripped key for blocking
  legalName          String? // where known
  tradingName        String? // DBA / trading name
  website            String?
  domain             String? // normalized primary domain
  country            String? // ISO 3166-1 alpha-2 (HQ country)
  confidence         Float    @default(0.0)
  identityStatus     String   @default("unresolved") // unresolved | resolved | high_confidence | possible | ambiguous | conflict
  verificationStatus String   @default("unverified") // unverified | verified | suspicious
  status             String   @default("active") // active | merged | deprecated
  mergedIntoId       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant              Tenant                   @relation(fields: [tenantId], references: [id])
  mergedInto          Organization?            @relation("OrgMergeTarget", fields: [mergedIntoId], references: [id])
  mergedFrom          Organization[]           @relation("OrgMergeTarget")
  roles               OrganizationRole[]
  identifiers         OrganizationIdentifier[]
  domains             OrganizationDomain[]
  emails              OrganizationEmail[]
  phones              OrganizationPhone[]
  locations           OrganizationLocation[]
  contacts            OrganizationContact[]
  sellers             Seller[]
  suppliers           Supplier[]
  manufacturers       Manufacturer[]
  relationshipsAsFrom CommercialRelationship[] @relation("CommercialRelFrom")
  relationshipsAsTo   CommercialRelationship[] @relation("CommercialRelTo")
  decisionsAsFrom     OrgIdentityDecision[]    @relation("OrgDecisionFrom")
  decisionsAsTo       OrgIdentityDecision[]    @relation("OrgDecisionTo")
  conflictsAsEntity   OrgIdentityConflict[]    @relation("OrgConflictEntity")
  candidatesAsFrom    OrgIdentityCandidate[]   @relation("OrgCandidateFrom")
  candidatesAsTo      OrgIdentityCandidate[]   @relation("OrgCandidateTo")
  mergeHistory        OrgMergeHistory[]        @relation("OrgMergeEntity")

  @@unique([tenantId, normalizedName])
  @@index([tenantId])
  @@index([normalizedName])
  @@index([searchKey])
  @@index([domain])
  @@index([identityStatus])
  @@index([country])
  @@map("organizations")
}

// ─── Organization Roles ──────────────────────────────────────────────────────

model OrganizationRole {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String
  role           String // SELLER | SUPPLIER | DISTRIBUTOR | IMPORTER | WHOLESALER | MANUFACTURER | BRAND_OWNER
  confidence     Float    @default(0.0) // 0.0–1.0
  evidenceSource String? // how this role was determined: source | manual | ai | inferred
  observedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([tenantId, organizationId, role])
  @@index([tenantId])
  @@index([organizationId])
  @@index([role])
  @@map("organization_roles")
}

// ─── Organization Identifiers ────────────────────────────────────────────────
// Registration IDs, VAT/TIN, business numbers, etc.

model OrganizationIdentifier {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String
  type           String // registration_id | vat | tin | business_number | customs_id
  value          String // raw identifier value
  normalized     String // normalized form
  country        String? // ISO country where issued
  sourceId       String? // which source provided this
  confidence     Float    @default(1.0)
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([tenantId, type, normalized])
  @@index([tenantId])
  @@index([organizationId])
  @@index([type, normalized])
  @@index([normalized])
  @@map("organization_identifiers")
}

// ─── Organization Domains ────────────────────────────────────────────────────

model OrganizationDomain {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String
  domain         String // normalized domain (e.g., "company.com")
  isPrimary      Boolean  @default(false)
  source         String   @default("source") // source | manual | inferred
  confidence     Float    @default(1.0)
  observedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([tenantId, domain])
  @@index([tenantId])
  @@index([organizationId])
  @@index([domain])
  @@map("organization_domains")
}

// ─── Organization Emails ─────────────────────────────────────────────────────

model OrganizationEmail {
  id              String   @id @default(cuid())
  tenantId        String
  organizationId  String
  email           String // full email address
  normalizedEmail String // normalized (lowercase, + stripped)
  domain          String // email domain
  isCorporate     Boolean  @default(false) // false = free provider
  source          String   @default("source")
  confidence      Float    @default(1.0)
  verified        Boolean  @default(false)
  observedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([tenantId, normalizedEmail])
  @@index([tenantId])
  @@index([organizationId])
  @@index([domain])
  @@map("organization_emails")
}

// ─── Organization Phones ─────────────────────────────────────────────────────

model OrganizationPhone {
  id              String   @id @default(cuid())
  tenantId        String
  organizationId  String
  rawPhone        String // original phone string
  normalizedPhone String? // E.164 where possible
  countryCode     String? // ISO country for phone
  source          String   @default("source")
  confidence      Float    @default(1.0)
  verified        Boolean  @default(false)
  observedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([tenantId, normalizedPhone])
  @@index([tenantId])
  @@index([organizationId])
  @@index([normalizedPhone])
  @@map("organization_phones")
}

// ─── Organization Locations ──────────────────────────────────────────────────

model OrganizationLocation {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String
  locationType   String // hq | warehouse | retail_store | distribution_center | regional_office | branch
  address        String? // full formatted address
  street         String?
  city           String?
  state          String?
  postalCode     String?
  country        String? // ISO 3166-1 alpha-2
  isPrimary      Boolean  @default(false)
  source         String   @default("source")
  confidence     Float    @default(1.0)
  observedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([tenantId])
  @@index([organizationId])
  @@index([country])
  @@index([city])
  @@map("organization_locations")
}

// ─── Organization Contacts ───────────────────────────────────────────────────

model OrganizationContact {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String
  name           String
  title          String?
  email          String?
  phone          String?
  department     String?
  source         String   @default("source")
  confidence     Float    @default(1.0)
  observedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([tenantId])
  @@index([organizationId])
  @@map("organization_contacts")
}

// ─── Commercial Relationships ────────────────────────────────────────────────
// Relationships between organizations (SELLS_TO, SUPPLIES, DISTRIBUTES, etc.)

model CommercialRelationship {
  id               String   @id @default(cuid())
  tenantId         String
  fromOrgId        String
  toOrgId          String
  relationshipType String // SELLS_TO | SUPPLIES | DISTRIBUTES | IMPORTS | WHOLESALSES | MANUFACTURES_FOR | OWNS_BRAND | AUTHORIZED_DISTRIBUTOR_OF | OPERATES_DOMAIN | PARTNER_OF
  confidence       Float    @default(0.0)
  evidenceJson     Json     @default("{}")
  observationType  String   @default("observed") // observed | inferred | probable
  sourceId         String?
  observedAt       DateTime @default(now())
  status           String   @default("active") // active | superseded | reversed
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fromOrg  Organization @relation("CommercialRelFrom", fields: [fromOrgId], references: [id])
  toOrg    Organization @relation("CommercialRelTo", fields: [toOrgId], references: [id])
  evidence Evidence[]   @relation("CommercialRelEvidence")

  @@unique([tenantId, fromOrgId, toOrgId, relationshipType])
  @@index([tenantId])
  @@index([fromOrgId])
  @@index([toOrgId])
  @@index([relationshipType])
  @@index([status])
  @@map("commercial_relationships")
}

// ─── Product ↔ Seller Link ───────────────────────────────────────────────────

model ProductSeller {
  id              String   @id @default(cuid())
  tenantId        String
  productId       String
  sellerId        String
  sellerSku       String? // seller-specific SKU
  sellerProductId String? // seller's product ID
  listingUrl      String?
  price           Decimal?
  currency        String?
  availability    String?
  stockStatus     String?
  observedAt      DateTime @default(now())
  sourceId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product  Product    @relation(fields: [productId], references: [id])
  seller   Seller     @relation(fields: [sellerId], references: [id])
  evidence Evidence[] @relation("ProductSellerEvidence")

  @@unique([tenantId, productId, sellerId, sellerSku])
  @@index([tenantId])
  @@index([productId])
  @@index([sellerId])
  @@index([observedAt])
  @@map("product_sellers")
}

// ─── Product ↔ Supplier Link ─────────────────────────────────────────────────

model ProductSupplier {
  id                String   @id @default(cuid())
  tenantId          String
  productId         String
  supplierId        String
  supplierProductId String? // supplier's product ID
  moq               Int? // minimum order quantity
  unitPack          String? // unit | case | carton
  price             Decimal?
  currency          String?
  availability      String?
  leadTimeDays      Int?
  observedAt        DateTime @default(now())
  sourceId          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product  Product    @relation(fields: [productId], references: [id])
  supplier Supplier   @relation(fields: [supplierId], references: [id])
  evidence Evidence[] @relation("ProductSupplierEvidence")

  @@unique([tenantId, productId, supplierId, supplierProductId])
  @@index([tenantId])
  @@index([productId])
  @@index([supplierId])
  @@index([observedAt])
  @@map("product_suppliers")
}

// ─── Org Identity Decisions ──────────────────────────────────────────────────

model OrgIdentityDecision {
  id                String    @id @default(cuid())
  tenantId          String
  fromOrgId         String
  toOrgId           String
  decision          String // EXACT_MATCH | HIGH_CONFIDENCE_MATCH | POSSIBLE_MATCH | NO_MATCH | CONFLICT | UNRESOLVED
  confidence        Float     @default(0.0)
  reasons           Json      @default("[]")
  // Structured matching dimensions
  nameMatch         String? // exact | high | medium | low | none
  domainMatch       String? // exact | none | conflict
  emailMatch        String? // exact | domain | none
  phoneMatch        String? // exact | none | conflict
  addressMatch      String? // exact | similar | none
  registrationMatch String? // exact | none | conflict
  sourceIdMatch     String? // exact | none | conflict
  countryMatch      String? // exact | compatible | different | none
  websiteMatch      String? // exact | similar | none
  roleCompatibility String? // compatible | neutral | conflicting
  conflictState     String? // none | open | resolved | dismissed
  sourceReliability Float?
  method            String    @default("deterministic") // deterministic | ai | manual | hybrid
  methodVersion     String?
  reviewerId        String?
  reviewedAt        DateTime?
  reviewOverride    String?
  createdAt         DateTime  @default(now())

  fromOrg  Organization @relation("OrgDecisionFrom", fields: [fromOrgId], references: [id])
  toOrg    Organization @relation("OrgDecisionTo", fields: [toOrgId], references: [id])
  evidence Evidence[]   @relation("OrgDecisionEvidence")

  @@index([tenantId])
  @@index([fromOrgId])
  @@index([toOrgId])
  @@index([decision])
  @@index([method])
  @@index([createdAt])
  @@map("org_identity_decisions")
}

// ─── Org Identity Conflicts ──────────────────────────────────────────────────

model OrgIdentityConflict {
  id              String    @id @default(cuid())
  tenantId        String
  entityType      String // organization | identifier | domain | email | phone
  entityId        String
  conflictType    String // registration_collision | domain_conflict | name_conflict | phone_conflict | email_conflict | source_id_conflict
  severity        String // low | medium | high | critical
  description     String
  conflictingData Json      @default("{}")
  status          String    @default("open") // open | resolved | dismissed | superseded
  resolvedAt      DateTime?
  resolvedBy      String?
  resolution      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  entity Organization @relation("OrgConflictEntity", fields: [entityId], references: [id])

  @@index([tenantId])
  @@index([entityId])
  @@index([conflictType])
  @@index([status])
  @@index([severity])
  @@map("org_identity_conflicts")
}

// ─── Org Identity Candidates ─────────────────────────────────────────────────

model OrgIdentityCandidate {
  id               String   @id @default(cuid())
  tenantId         String
  fromOrgId        String
  toOrgId          String
  status           String   @default("pending") // pending | processing | matched | rejected | ambiguous | failed
  priority         Int      @default(0)
  generationMethod String   @default("blocking") // blocking | identifier | domain | manual | ai
  blockingKey      String?
  attempts         Int      @default(0)
  maxAttempts      Int      @default(3)
  lastError        String?
  resultJson       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fromOrg Organization @relation("OrgCandidateFrom", fields: [fromOrgId], references: [id])
  toOrg   Organization @relation("OrgCandidateTo", fields: [toOrgId], references: [id])

  @@unique([tenantId, fromOrgId, toOrgId])
  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@index([fromOrgId])
  @@index([toOrgId])
  @@map("org_identity_candidates")
}

// ─── Org Merge History ───────────────────────────────────────────────────────

model OrgMergeHistory {
  id            String    @id @default(cuid())
  tenantId      String
  entityId      String // the organization involved
  action        String // merged | split | superseded | overridden
  fromOrgId     String?
  toOrgId       String?
  reason        String
  evidenceJson  Json      @default("{}")
  actorType     String    @default("system") // system | ai | manual
  actorId       String?
  reversedAt    DateTime?
  reversedBy    String?
  reverseReason String?
  createdAt     DateTime  @default(now())

  entity Organization @relation("OrgMergeEntity", fields: [entityId], references: [id])

  @@index([tenantId])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@map("org_merge_history")
}

// =============================================================================
// PHASE 6 — CLAIMS, CONFLICTS, CALCULATIONS & PROVENANCE EDGES
// =============================================================================

// ─── Claims ──────────────────────────────────────────────────────────────────
// Structured statements backed by evidence: "Seller A sells Product B"

model Claim {
  id                String    @id @default(cuid())
  tenantId          String
  subjectType       String // product | seller | supplier | organization | brand
  subjectId         String
  predicate         String // SELLS | SUPPLIES | DISTRIBUTES | MANUFACTURES | OWNS_BRAND | PRICE_IS | AVAILABLE | etc.
  objectType        String? // product | seller | supplier | organization | brand | value
  objectId          String? // referenced entity ID or null for value claims
  value             Json? // literal value for value claims (e.g., price amount)
  claimType         String // relationship | attribute | identity | existence
  status            String    @default("active") // active | superseded | retracted | disputed
  confidence        Float     @default(0.0)
  observationStatus String    @default("observed") // observed | inferred | probable | unknown
  validFrom         DateTime?
  validUntil        DateTime?
  observedAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  evidence Evidence[] @relation("ClaimEvidence")

  @@index([tenantId])
  @@index([subjectType, subjectId])
  @@index([predicate])
  @@index([claimType])
  @@index([status])
  @@index([observationStatus])
  @@index([observedAt])
  @@map("claims")
}

// ─── Evidence Conflicts ──────────────────────────────────────────────────────
// First-class conflict tracking between contradictory evidence.

model EvidenceConflict {
  id                      String    @id @default(cuid())
  tenantId                String
  entityType              String // product | organization | seller | supplier | brand
  entityId                String
  conflictType            String // value_conflict | identity_conflict | attribute_conflict | relationship_conflict
  description             String
  status                  String    @default("open") // open | under_review | resolved | dismissed
  resolvedAt              DateTime?
  resolvedBy              String? // user ID or system
  resolution              String?
  resolverMethod          String? // manual | ai | auto
  supportingEvidenceId    String
  contradictingEvidenceId String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  supportingEvidence    Evidence @relation("ConflictSupporting", fields: [supportingEvidenceId], references: [id])
  contradictingEvidence Evidence @relation("ConflictContradicting", fields: [contradictingEvidenceId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([conflictType])
  @@index([status])
  @@index([supportingEvidenceId])
  @@index([contradictingEvidenceId])
  @@map("evidence_conflicts")
}

// ─── Calculations ────────────────────────────────────────────────────────────
// Provenance for computed values: average price, landed cost, demand signals.

model Calculation {
  id                   String    @id @default(cuid())
  tenantId             String
  calculationType      String // average_price | price_trend | review_velocity | seller_count | demand_acceleration | landed_cost | market_spread | margin
  algorithm            String // e.g., "median", "weighted_average", "linear_regression"
  algorithmVersion     String // e.g., "price-statistics-v1"
  inputs               Json      @default("[]") // structured input references
  outputs              Json // calculation result
  units                String? // e.g., "BDT", "USD", "count"
  currency             String? // ISO 4217 where applicable
  calculationTimestamp DateTime  @default(now())
  confidence           Float     @default(0.0)
  status               String    @default("active") // active | superseded | invalid
  // Entity this calculation is about
  entityType           String // product | seller | supplier | organization | market
  entityId             String
  sourceId             String?
  validFrom            DateTime?
  validUntil           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  inputEvidence  Evidence[] @relation("CalculationInputEvidence")
  outputEvidence Evidence[] @relation("CalculationOutputEvidence")

  @@index([tenantId])
  @@index([calculationType])
  @@index([entityType, entityId])
  @@index([status])
  @@index([calculationTimestamp])
  @@index([algorithm])
  @@map("calculations")
}

// ─── Provenance Edges ────────────────────────────────────────────────────────
// Explicit graph edges for provenance traversal.
// source → raw_response → observation → evidence → claim → decision

model ProvenanceEdge {
  id                String    @id @default(cuid())
  tenantId          String
  sourceNodeId      String // evidence ID or other entity ID
  sourceNodeType    String // evidence | claim | calculation | observation | raw_response | source | decision | relationship
  targetNodeId      String
  targetNodeType    String // same vocabulary as sourceNodeType
  relationshipType  String // DERIVED_FROM | SUPPORTS | CONTRADICTS | COMPUTED_FROM | OBSERVED_IN | EXTRACTED_FROM
  confidence        Float     @default(1.0)
  observationStatus String    @default("observed") // observed | inferred | probable | unknown
  observedAt        DateTime  @default(now())
  validFrom         DateTime?
  validUntil        DateTime?
  sourceId          String? // which external source
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, sourceNodeId, targetNodeId, relationshipType])
  @@index([tenantId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@index([sourceNodeType])
  @@index([targetNodeType])
  @@index([relationshipType])
  @@index([observationStatus])
  @@map("provenance_edges")
}

// =============================================================================
// PHASE 7 — DEMAND & TREND INTELLIGENCE
// =============================================================================
// Normalized demand signals (time-series) and derived demand calculations.
// Signals are NEVER overwritten — each record is a temporal observation.
// Calculations are versioned and linked to input signals via provenance.

// ─── Demand Signals ──────────────────────────────────────────────────────────
// Normalized time-series demand signal observations extracted from evidence.
// Each record is one metric at one point in time from one source.

model DemandSignal {
  id                 String    @id @default(cuid())
  tenantId           String
  productId          String?
  productVariantId   String?
  brandId            String?
  sellerId           String?
  sourceId           String
  evidenceId         String?
  signalType         String // SEARCH | SOCIAL | MARKETPLACE | SELLER_COUNT | LISTING_COUNT | REVIEW_COUNT | REVIEW_VELOCITY | PRICE | PRICE_CHANGE | AVAILABILITY | STOCK | RANK | RATING | ENGAGEMENT | MENTION | QUERY_VOLUME | QUERY_GROWTH | PRODUCT_ACTIVITY
  metric             String // specific metric name within the signal type
  value              Float   // numeric value
  originalValue      Float?  // value before normalization
  unit               String? // count | percentage | currency | index | score | reviews_per_day | etc.
  currency           String? // ISO 4217 where applicable
  observedAt         DateTime // when the data was observed/published
  retrievedAt        DateTime // when the data was fetched
  periodStart        DateTime? // start of observation period
  periodEnd          DateTime? // end of observation period
  granularity        String    @default("day") // minute | hour | day | week | month
  geography          String    @default("global") // global | region | country | BD
  country            String? // ISO 3166-1 alpha-2 where applicable
  marketplace        String? // source marketplace scope
  confidence         Float     @default(0.0) // 0.0–1.0
  freshness          String    @default("unknown") // live | fresh | aging | stale | unknown
  observationStatus  String    @default("observed") // observed | inferred | probable | interpolated | unknown
  dataQuality        String    @default("valid") // valid | partial | suspect | invalid | missing
  sourceReliability  Float     @default(0.5) // 0.0–1.0 from SourceReliability
  status             String    @default("active") // active | superseded | retracted
  contentHash        String? // SHA-256 for deduplication
  isOutlier          Boolean   @default(false)
  outlierMethod      String? // iqr | zscore | mad | rolling_deviation
  outlierScore       Float? // how far from normal
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  source         Source   @relation(fields: [sourceId], references: [id])

  @@unique([tenantId, sourceId, signalType, metric, observedAt, granularity, geography, contentHash])
  @@index([tenantId])
  @@index([productId])
  @@index([productVariantId])
  @@index([brandId])
  @@index([sellerId])
  @@index([sourceId])
  @@index([signalType])
  @@index([metric])
  @@index([observedAt])
  @@index([periodStart, periodEnd])
  @@index([granularity])
  @@index([geography])
  @@index([country])
  @@index([marketplace])
  @@index([status])
  @@index([dataQuality])
  @@index([freshness])
  @@index([contentHash])
  // Composite indexes for common time-series queries
  @@index([tenantId, productId, signalType, observedAt])
  @@index([tenantId, productId, metric, observedAt])
  @@index([tenantId, productVariantId, signalType, observedAt])
  @@index([tenantId, brandId, signalType, observedAt])
  @@index([tenantId, geography, signalType, observedAt])
  @@map("demand_signals")
}

// ─── Demand Calculations ─────────────────────────────────────────────────────
// Persisted derived demand metrics with full provenance.
// Each calculation is versioned and linked to its input signals.

model DemandCalculation {
  id                   String    @id @default(cuid())
  tenantId             String
  calculationType      String // current_demand | demand_growth | demand_acceleration | demand_velocity | trend_classification | momentum | seasonality | persistence | volatility | price_activity | seller_activity | review_velocity | availability_signal | market_activity | bangladesh_demand
  algorithm            String // e.g., "demand-growth-v1", "trend-classification-v1"
  algorithmVersion     String // e.g., "v1"
  entityType           String    @default("product") // product | variant | brand | category | market
  entityId             String // the product/brand/category ID
  productId            String?
  productVariantId     String?
  brandId              String?
  result               Json // calculation result object
  resultSummary        String? // human-readable summary
  units                String? // percentage | count | index | currency | reviews_per_day | etc.
  currency             String? // ISO 4217 where applicable
  windowDays           Int? // analysis window in days
  granularity          String? // minute | hour | day | week | month
  geography            String    @default("global") // global | BD | country code
  country              String? // ISO 3166-1 alpha-2
  confidence           Float     @default(0.0) // 0.0–1.0
  dataSufficiency      String    @default("unknown") // sufficient | limited | insufficient | stale | conflicted
  freshness            String    @default("unknown") // live | fresh | aging | stale | unknown
  observationCount     Int       @default(0)
  sourceCount          Int       @default(0)
  periodStart          DateTime?
  periodEnd            DateTime?
  inputSignalIds       Json      @default("[]") // array of DemandSignal IDs used as input
  inputCalculationIds  Json      @default("[]") // array of DemandCalculation IDs used as input
  status               String    @default("active") // active | superseded | invalid
  calculatedAt         DateTime  @default(now())
  validFrom            DateTime?
  validUntil           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([calculationType])
  @@index([entityType, entityId])
  @@index([productId])
  @@index([productVariantId])
  @@index([brandId])
  @@index([geography])
  @@index([country])
  @@index([status])
  @@index([calculatedAt])
  @@index([algorithm])
  @@index([confidence])
  @@index([dataSufficiency])
  @@index([freshness])
  @@index([windowDays])
  // Composite indexes for common queries
  @@index([tenantId, productId, calculationType, status])
  @@index([tenantId, entityId, calculationType, calculatedAt])
  @@index([tenantId, brandId, calculationType, status])
  @@index([tenantId, geography, calculationType, status])
  @@map("demand_calculations")
}

// =============================================================================
// PHASE 8 — DECISION INTELLIGENCE & RESELLER OPPORTUNITY ENGINE
// =============================================================================
// Opportunities are immutable, evidence-backed commercial opportunity records
// derived from Phase 7 demand signals. Each opportunity has:
// - A deterministic score and confidence
// - Full evidence provenance back to demand signals and sources
// - Structured risk assessment
// - Recommended investigative actions
// Opportunities are NEVER overwritten — new calculations create new records.

// ─── Opportunity Status ──────────────────────────────────────────────────────

enum OpportunityStatus {
  DETECTED
  VALIDATED
  WATCH
  ACTIONABLE
  DISMISSED
  EXPIRED
}

// ─── Opportunity ─────────────────────────────────────────────────────────────
// Immutable opportunity record representing a potentially actionable commercial
// opportunity around a product/product variant and market.

model Opportunity {
  id                  String            @id @default(cuid())
  tenantId            String

  productId           String?
  productVariantId    String?

  geographyCode       String?
  categoryId          String?

  opportunityType     String // EMERGING_PRODUCT | GROWING_PRODUCT | SUSTAINED_DEMAND | SEASONAL_OPPORTUNITY | GEOGRAPHIC_OPPORTUNITY | MOMENTUM_OPPORTUNITY | UNDEREXPLORED_CATEGORY

  status              OpportunityStatus @default(DETECTED)

  score               Float // 0–100 opportunity score
  confidence          Float // 0.0–1.0 confidence in the opportunity

  title               String
  summary             String

  detectedAt          DateTime
  validFrom           DateTime
  validUntil          DateTime?

  algorithmVersion    String // e.g., "8.0.0"

  contentHash         String // SHA-256 for deduplication

  // Score breakdown (persisted for explainability)
  demandScore         Float     @default(0)
  growthScore         Float     @default(0)
  velocityScore       Float     @default(0)
  persistenceScore    Float     @default(0)
  accelerationScore   Float     @default(0)
  seasonalityScore    Float     @default(0)
  sourceDiversityScore Float    @default(0)
  riskScore           Float     @default(0)

  createdAt           DateTime @default(now())

  tenant              Tenant   @relation(fields: [tenantId], references: [id])

  evidence            OpportunityEvidence[]
  risks               OpportunityRisk[]
  actions             OpportunityAction[]
  calculations        OpportunityCalculation[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, productId])
  @@index([tenantId, productVariantId])
  @@index([tenantId, opportunityType])
  @@index([tenantId, geographyCode])
  @@index([tenantId, detectedAt])
  @@index([tenantId, score])
  @@unique([tenantId, contentHash])
  @@map("opportunities")
}

// ─── Opportunity Calculation ─────────────────────────────────────────────────
// Immutable calculation snapshot. Each calculation is versioned and preserves
// the exact inputs and outputs for historical reproducibility.

model OpportunityCalculation {
  id                    String   @id @default(cuid())

  opportunityId         String

  algorithmVersion      String // e.g., "8.0.0"

  demandScore           Float
  growthScore           Float
  velocityScore         Float
  persistenceScore      Float
  accelerationScore     Float
  seasonalityScore      Float
  sourceDiversityScore  Float
  confidenceScore       Float

  competitionScore      Float?  // null = data unavailable
  commercialScore       Float?  // null = data unavailable
  sourcingScore         Float?  // null = data unavailable
  riskScore             Float

  finalScore            Float

  inputHash             String // SHA-256 of canonical input for dedup

  inputSignalIds        Json     @default("[]") // array of DemandSignal IDs

  calculatedAt          DateTime @default(now())

  opportunity           Opportunity @relation(fields: [opportunityId], references: [id])

  @@index([opportunityId])
  @@index([calculatedAt])
  @@index([algorithmVersion])
  @@unique([opportunityId, inputHash])
  @@map("opportunity_calculations")
}

// ─── Opportunity Evidence ────────────────────────────────────────────────────
// Preserves exactly WHY an opportunity exists. Each evidence record links
// back to a demand signal and optionally to a source.

model OpportunityEvidence {
  id                String   @id @default(cuid())

  opportunityId     String

  evidenceType      String // DEMAND_GROWTH | DEMAND_VELOCITY | DEMAND_PERSISTENCE | SOURCE_DIVERSITY | SEASONALITY | ACCELERATION | CROSS_SIGNAL_AGREEMENT
  sourceId          String?
  demandSignalId    String?

  weight            Float // 0.0–1.0 weight in the calculation
  contribution      Float // 0.0–1.0 how much this evidence contributed

  snapshotAt        DateTime // when the evidence was captured

  metadata          Json?    // additional evidence-specific data

  createdAt         DateTime @default(now())

  opportunity       Opportunity @relation(fields: [opportunityId], references: [id])

  @@index([opportunityId])
  @@index([demandSignalId])
  @@index([sourceId])
  @@index([evidenceType])
  @@map("opportunity_evidence")
}

// ─── Opportunity Risk ────────────────────────────────────────────────────────
// Structured risk records. A risk is only recorded when evidence supports it.

model OpportunityRisk {
  id              String   @id @default(cuid())

  opportunityId   String

  riskType        String // LOW_DEMAND_CONFIDENCE | HIGH_VOLATILITY | SEASONAL_DEPENDENCY | SOURCE_CONFLICT | HIGH_COMPETITION | LOW_MARGIN | SUPPLIER_UNCERTAINTY | PRICE_UNCERTAINTY | GEOGRAPHIC_LIMITATION | DATA_SPARSE | STALE_SIGNAL | COMMERCIAL_DATA_MISSING
  severity        String // low | medium | high | critical
  score           Float  // 0.0–1.0 risk score

  description     String

  evidence        Json?  // supporting evidence for the risk

  createdAt       DateTime @default(now())

  opportunity     Opportunity @relation(fields: [opportunityId], references: [id])

  @@index([opportunityId])
  @@index([riskType])
  @@index([severity])
  @@map("opportunity_risks")
}

// ─── Opportunity Action ──────────────────────────────────────────────────────
// Recommended investigative actions. Actions represent decision-support steps,
// not automatic purchasing instructions.

model OpportunityAction {
  id              String   @id @default(cuid())

  opportunityId   String

  actionType      String // INVESTIGATE_SUPPLIERS | CHECK_COMPETITORS | VERIFY_PRICE | RUN_SMALL_TEST | WATCH_DEMAND | INVESTIGATE_SOURCE_CONFLICT | CHECK_SEASONALITY | CHECK_LOCAL_AVAILABILITY | COMPARE_IMPORT_COST
  priority        String // low | medium | high | critical

  title           String
  description     String

  reason          String // why this action is recommended

  createdAt       DateTime @default(now())

  opportunity     Opportunity @relation(fields: [opportunityId], references: [id])

  @@index([opportunityId])
  @@index([actionType])
  @@index([priority])
  @@map("opportunity_actions")
}

// =============================================================================
// PHASE 8 (ORIGINAL ROADMAP) — AUTHENTICITY INTELLIGENCE
// =============================================================================
// Evidence-backed authenticity assessments for products, SKUs, brands, sellers,
// suppliers, listings, and documents. Each assessment is:
// - Deterministic and explainable
// - Evidence-backed with full provenance
// - Historically immutable (new calculations create new records)
// - Tenant-isolated
// - SHA-256 idempotent
// Assessments are NEVER overwritten — new calculations create new records.

// ─── Authenticity Assessment Status ──────────────────────────────────────────

enum AuthenticityStatus {
  UNASSESSED
  INSUFFICIENT_EVIDENCE
  VERIFIED
  LIKELY_AUTHENTIC
  UNCERTAIN
  SUSPICIOUS
  LIKELY_COUNTERFEIT
  CONTRADICTED
}

// ─── Authenticity Assessment ─────────────────────────────────────────────────
// One complete evaluation of a subject's authenticity.

model AuthenticityAssessment {
  id                  String              @id @default(cuid())
  tenantId            String

  subjectType         String // PRODUCT | SKU | BRAND | SELLER | SUPPLIER | LISTING | DOCUMENT
  subjectId           String

  status              AuthenticityStatus  @default(UNASSESSED)

  score               Float               @default(0) // 0–100 authenticity score
  confidence          Float               @default(0) // 0.0–1.0 confidence in the assessment

  algorithmVersion    String              @default("1.0.0")

  inputHash           String              // SHA-256 of canonical input for dedup
  calculationHash     String?             // SHA-256 of calculation result

  evidenceCount       Int                 @default(0)
  signalCount         Int                 @default(0)
  contradictionCount  Int                 @default(0)
  positiveSignalCount Int                 @default(0)
  negativeSignalCount Int                 @default(0)

  dataCompleteness    Float               @default(0) // 0.0–1.0
  sourceDiversity     Int                 @default(0) // number of distinct sources

  assessedAt          DateTime            @default(now())
  validFrom           DateTime?
  validUntil          DateTime?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  tenant              Tenant                          @relation(fields: [tenantId], references: [id])
  signals             AuthenticitySignal[]
  evidenceLinks       AuthenticityEvidenceLink[]
  risks               AuthenticityRisk[]
  decisions           AuthenticityDecision[]

  @@unique([tenantId, subjectType, subjectId, inputHash])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, subjectType, subjectId])
  @@index([tenantId, score])
  @@index([tenantId, confidence])
  @@index([tenantId, algorithmVersion])
  @@index([inputHash])
  @@index([calculationHash])
  @@index([assessedAt])
  @@map("authenticity_assessments")
}

// ─── Authenticity Signal ─────────────────────────────────────────────────────
// Individual signal contributing to an assessment.

model AuthenticitySignal {
  id              String   @id @default(cuid())
  tenantId        String
  assessmentId    String

  signalType      String // PRODUCT_IDENTITY_MATCH | SKU_MATCH | BRAND_MATCH | SELLER_AUTHORIZATION | PRICE_ANOMALY | etc.
  direction       String // POSITIVE | NEGATIVE | NEUTRAL | UNKNOWN

  score           Float    @default(0) // 0.0–1.0 signal strength
  weight          Float    @default(1.0) // 0.0–2.0 weight in calculation
  confidence      Float    @default(0) // 0.0–1.0

  subjectType     String? // product | seller | supplier | brand | listing | document
  subjectId       String?

  evidenceId      String?  // link to existing Evidence

  metadata        Json     @default("{}") // signal-specific data

  createdAt       DateTime @default(now())

  assessment      AuthenticityAssessment @relation(fields: [assessmentId], references: [id])

  @@index([tenantId])
  @@index([assessmentId])
  @@index([signalType])
  @@index([direction])
  @@index([evidenceId])
  @@index([subjectType, subjectId])
  @@map("authenticity_signals")
}

// ─── Authenticity Evidence Link ──────────────────────────────────────────────
// Links an assessment to existing Evidence records with role tracking.

model AuthenticityEvidenceLink {
  id              String   @id @default(cuid())
  tenantId        String
  assessmentId    String

  evidenceId      String // link to existing Phase 6 Evidence
  evidenceRole    String // SUPPORTING | CONTRADICTING | CONTEXTUAL | UNRESOLVED
  evidenceStrength String // DIRECT | STRONG | MODERATE | WEAK | CONTEXTUAL

  relevance       Float    @default(1.0) // 0.0–1.0 relevance to this assessment
  effect          Float    @default(0)  // -1.0 to 1.0 effect on score

  observedAt      DateTime @default(now())

  createdAt       DateTime @default(now())

  assessment      AuthenticityAssessment @relation(fields: [assessmentId], references: [id])

  @@unique([assessmentId, evidenceId])
  @@index([tenantId])
  @@index([assessmentId])
  @@index([evidenceId])
  @@index([evidenceRole])
  @@index([evidenceStrength])
  @@map("authenticity_evidence_links")
}

// ─── Authenticity Risk ───────────────────────────────────────────────────────
// Structured risk records for an assessment.

model AuthenticityRisk {
  id              String   @id @default(cuid())
  tenantId        String
  assessmentId    String

  riskType        String // IDENTITY_CONTRADICTION | SOURCE_CONFLICT | PRICE_ANOMALY | MISSING_EVIDENCE | UNVERIFIED_CLAIM | DOCUMENT_MISMATCH | CONTENT_REUSE | SELLER_INCONSISTENCY | SUPPLIER_UNCERTAINTY | AUTHORIZATION_GAP
  severity        String // low | medium | high | critical
  score           Float    @default(0) // 0.0–1.0

  title           String
  description     String

  evidence        Json?    // supporting evidence for the risk

  createdAt       DateTime @default(now())

  assessment      AuthenticityAssessment @relation(fields: [assessmentId], references: [id])

  @@index([tenantId])
  @@index([assessmentId])
  @@index([riskType])
  @@index([severity])
  @@map("authenticity_risks")
}

// ─── Authenticity Decision ───────────────────────────────────────────────────
// Immutable calculation snapshot preserving exact inputs and outputs.

model AuthenticityDecision {
  id                    String   @id @default(cuid())
  assessmentId          String

  algorithmVersion      String

  // Score breakdown
  identityScore         Float    @default(0)
  brandScore            Float    @default(0)
  sellerScore           Float    @default(0)
  supplierScore         Float    @default(0)
  listingScore          Float    @default(0)
  documentScore         Float    @default(0)
  priceScore            Float    @default(0)
  corroborationScore    Float    @default(0)

  // Confidence breakdown
  evidenceQuantityScore Float    @default(0)
  evidenceQualityScore  Float    @default(0)
  independenceScore     Float    @default(0)
  completenessScore     Float    @default(0)
  consistencyScore      Float    @default(0)

  contradictionPenalty  Float    @default(0)

  finalScore            Float
  finalConfidence       Float

  inputHash             String
  evidenceIds           Json     @default("[]")
  signalIds             Json     @default("[]")

  calculatedAt          DateTime @default(now())

  assessment            AuthenticityAssessment @relation(fields: [assessmentId], references: [id])

  @@index([assessmentId])
  @@index([calculatedAt])
  @@index([algorithmVersion])
  @@unique([assessmentId, inputHash])
  @@map("authenticity_decisions")
}

// =============================================================================
// PHASE 9 — SUPPLY-CHAIN TRACING & PROVENANCE GRAPH ENGINE
// =============================================================================
// Evidence-backed supply-chain graph with deterministic confidence, contradiction
// detection, temporal reconstruction, and multi-hop path discovery.
// Nodes reference existing canonical entities where available (no duplicates).
// Edges are NEVER silently overwritten — observations are immutable.
// All calculations are deterministic and versioned.

enum SupplyChainNodeType {
  PRODUCT
  SKU
  BRAND
  MANUFACTURER
  AUTHORIZED_DISTRIBUTOR
  DISTRIBUTOR
  SUPPLIER
  SELLER
  LISTING
  OFFER
  FULFILLMENT_PROVIDER
  WAREHOUSE
  EXPORTER
  IMPORTER
  ORIGIN_COUNTRY
  ORIGIN_REGION
  ORIGIN_CITY
  PORT
  TRADE_ROUTE
  SHIPMENT
  TRADE_OBSERVATION
  DESTINATION_COUNTRY
  DESTINATION_REGION
  DESTINATION_CITY
  BANGLADESH_MARKET_ENTITY
  BANGLADESH_IMPORTER
  BANGLADESH_DISTRIBUTOR
  BANGLADESH_RESELLER
  UNKNOWN
}

enum SupplyChainEdgeType {
  BRAND_MANUFACTURES_PRODUCT
  MANUFACTURER_PRODUCES_SKU
  MANUFACTURER_DISTRIBUTES
  MANUFACTURER_SUPPLIES
  MANUFACTURER_EXPORTS
  AUTHORIZED_DISTRIBUTOR_DISTRIBUTES
  DISTRIBUTOR_SUPPLIES
  SUPPLIER_SUPPLIES
  SUPPLIER_SOURCES_FROM
  SELLER_PURCHASES_FROM
  SELLER_SUPPLIES
  SELLER_LISTS
  SELLER_OFFERS
  LISTING_REPRESENTS_PRODUCT
  LISTING_OFFERS_SKU
  FULFILLMENT_BY
  STORED_AT
  ORIGINATED_FROM
  EXPORTED_FROM
  IMPORTED_TO
  EXPORTER_EXPORTS
  IMPORTER_IMPORTS
  SHIPMENT_FROM
  SHIPMENT_TO
  TRADE_OBSERVATION_SUPPORTS
  DESTINATION_TO
  SOLD_IN_MARKET
  BANGLADESH_IMPORTER_DISTRIBUTES
  BANGLADESH_DISTRIBUTOR_SUPPLIES
  BANGLADESH_SUPPLIER_SUPPLIES
  BANGLADESH_RESELLER_SELLS
}

enum SupplyChainRelationshipStatus {
  OBSERVED
  CLAIMED
  INFERRED
  CORROBORATED
  CONFIRMED
  CONTRADICTED
  UNKNOWN
}

enum SupplyChainConflictResolutionState {
  OPEN
  RESOLVED
  SUPERSEDED
  UNRESOLVED
}

// ─── Supply-Chain Node ────────────────────────────────────────────────────────
// Represents any entity in the supply-chain graph. Reuses existing canonical
// entities (Product, Brand, Seller, Supplier, Manufacturer, Organization) via
// polymorphic canonicalEntityType/canonicalEntityId references.

model SupplyChainNode {
  id                  String   @id @default(cuid())
  tenantId            String
  nodeType            SupplyChainNodeType
  name                String
  normalizedName      String
  canonicalEntityType String? // product | productVariant | brand | seller | supplier | manufacturer | organization
  canonicalEntityId   String? // FK to the canonical entity where applicable
  sourceEntityId      String? // external representation ID from a source
  sourceId            String? // which source provided this node
  country             String? // ISO 3166-1 alpha-2
  identityStatus      String   @default("unresolved") // resolved | high_confidence | possible | ambiguous | conflict | unresolved
  identityConfidence  Float    @default(0.0)
  metadata            Json     @default("{}")
  observedAt          DateTime @default(now())
  retrievedAt         DateTime @default(now())
  validFrom           DateTime?
  validTo             DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  edgesFrom           SupplyChainEdge[]   @relation("EdgeFromNode")
  edgesTo             SupplyChainEdge[]   @relation("EdgeToNode")
  claimsAsClaiming    SupplyChainClaim[]  @relation("ClaimClaiming")
  claimsAsTarget      SupplyChainClaim[]  @relation("ClaimTarget")
  conflicts           SupplyChainConflict[]

  @@unique([tenantId, nodeType, normalizedName, sourceId])
  @@index([tenantId])
  @@index([nodeType])
  @@index([canonicalEntityType, canonicalEntityId])
  @@index([normalizedName])
  @@index([identityStatus])
  @@index([country])
  @@map("supply_chain_nodes")
}

// ─── Supply-Chain Edge ────────────────────────────────────────────────────────
// Represents a relationship between two nodes. Has explicit status, confidence,
// evidence tracking, and temporal validity.

model SupplyChainEdge {
  id                  String   @id @default(cuid())
  tenantId            String
  fromNodeId          String
  toNodeId            String
  edgeType            SupplyChainEdgeType
  relationshipStatus  SupplyChainRelationshipStatus @default(UNKNOWN)
  confidence          Float    @default(0.0)
  evidenceStrength    Float    @default(0.0)
  sourceDiversity     Int      @default(0)
  evidenceCount       Int      @default(0)
  observationCount    Int      @default(0)
  isContradicted      Boolean  @default(false)
  contradictionCount  Int      @default(0)
  contentHash         String? // SHA-256 of canonical inputs for dedup
  directness          String   @default("direct") // direct | inferred
  algorithmVersion    String   @default("SUPPLY_CHAIN_ALGORITHM_V1")
  observedAt          DateTime @default(now())
  validFrom           DateTime?
  validTo             DateTime?
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant              Tenant                  @relation(fields: [tenantId], references: [id])
  fromNode            SupplyChainNode         @relation("EdgeFromNode", fields: [fromNodeId], references: [id])
  toNode              SupplyChainNode         @relation("EdgeToNode", fields: [toNodeId], references: [id])
  observations        SupplyChainObservation[]
  evidenceLinks       SupplyChainEvidenceLink[]
  conflicts           SupplyChainConflict[]

  @@unique([tenantId, fromNodeId, toNodeId, edgeType, contentHash])
  @@index([tenantId])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([edgeType])
  @@index([relationshipStatus])
  @@index([contentHash])
  @@index([confidence])
  @@index([isContradicted])
  @@index([validFrom, validTo])
  @@map("supply_chain_edges")
}

// ─── Supply-Chain Observation ─────────────────────────────────────────────────
// Immutable record of what was observed about a relationship from a source.
// NEVER overwritten — new evidence creates new observations.

model SupplyChainObservation {
  id                  String   @id @default(cuid())
  tenantId            String
  edgeId              String
  sourceId            String
  evidenceId          String? // link to Phase 6 Evidence
  observationStatus   String   @default("observed") // observed | inferred | probable | unknown
  observedValue       Json     // what was observed about this relationship
  contentHash         String   // SHA-256 for dedup
  observedAt          DateTime
  retrievedAt         DateTime
  validFrom           DateTime?
  validTo             DateTime?
  parserVersion       String?
  createdAt           DateTime @default(now())

  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  edge                SupplyChainEdge     @relation(fields: [edgeId], references: [id])
  source              Source              @relation(fields: [sourceId], references: [id])
  evidence            Evidence?           @relation(fields: [evidenceId], references: [id])

  @@unique([tenantId, edgeId, sourceId, contentHash])
  @@index([tenantId])
  @@index([edgeId])
  @@index([sourceId])
  @@index([evidenceId])
  @@index([contentHash])
  @@index([observedAt])
  @@index([observationStatus])
  @@map("supply_chain_observations")
}

// ─── Supply-Chain Evidence Link ───────────────────────────────────────────────
// Links an edge to existing Phase 6 Evidence records with role tracking.

model SupplyChainEvidenceLink {
  id              String   @id @default(cuid())
  tenantId        String
  edgeId          String
  evidenceId      String // link to existing Phase 6 Evidence
  evidenceRole    String // SUPPORTING | CONTRADICTING | CONTEXTUAL | UNRESOLVED
  evidenceStrength String // DIRECT | STRONG | MODERATE | WEAK | CONTEXTUAL
  relevance       Float    @default(1.0) // 0.0–1.0
  effect          Float    @default(0.0) // -1.0 to 1.0
  sourceId        String?
  observedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  edge            SupplyChainEdge     @relation(fields: [edgeId], references: [id])
  evidence        Evidence            @relation("SCEvidenceLink", fields: [evidenceId], references: [id])

  @@unique([edgeId, evidenceId])
  @@index([tenantId])
  @@index([edgeId])
  @@index([evidenceId])
  @@index([evidenceRole])
  @@map("supply_chain_evidence_links")
}

// ─── Supply-Chain Conflict ────────────────────────────────────────────────────
// First-class contradiction tracking for supply-chain relationships.

model SupplyChainConflict {
  id                      String    @id @default(cuid())
  tenantId                String
  edgeId                  String?
  nodeId                  String?
  conflictType            String // CONTRADICTORY_MANUFACTURER | CONTRADICTORY_ORIGIN | TEMPORAL_OVERLAP | SUSPICIOUS_SHORTCUT | SELF_LOOP | INVALID_RELATIONSHIP | CONTRADICTORY_EVIDENCE
  severity                String // low | medium | high | critical
  description             String
  supportingEvidenceId    String
  contradictingEvidenceId String
  resolutionState         SupplyChainConflictResolutionState @default(OPEN)
  resolvedAt              DateTime?
  resolvedBy              String?
  resolution              String?
  resolutionEvidenceId    String?
  detectedAt              DateTime  @default(now())
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tenant                  Tenant              @relation(fields: [tenantId], references: [id])
  edge                    SupplyChainEdge?    @relation(fields: [edgeId], references: [id])
  node                    SupplyChainNode?    @relation(fields: [nodeId], references: [id])

  @@index([tenantId])
  @@index([edgeId])
  @@index([nodeId])
  @@index([conflictType])
  @@index([severity])
  @@index([resolutionState])
  @@index([detectedAt])
  @@map("supply_chain_conflicts")
}

// ─── Supply-Chain Assessment ──────────────────────────────────────────────────
// Deterministic summary of graph state for a subject entity.
// Immutable snapshots — new calculations create new records.

model SupplyChainAssessment {
  id                      String   @id @default(cuid())
  tenantId                String
  subjectType             String // PRODUCT | SKU | SELLER | SUPPLIER | BRAND | ORGANIZATION
  subjectId               String
  status                  String   @default("PENDING") // PENDING | COMPLETE | STALE | CONTRADICTED | INSUFFICIENT
  algorithmVersion        String   @default("SUPPLY_CHAIN_ALGORITHM_V1")
  inputHash               String // SHA-256 of canonical inputs — deterministic fingerprint
  version                 Int      @default(1) // monotonically increasing per subject for history
  graphCompleteness       Float    @default(0.0)
  knownNodeCount          Int      @default(0)
  unknownNodeCount        Int      @default(0)
  knownEdgeCount          Int      @default(0)
  unknownEdgeCount        Int      @default(0)
  confirmedEdgeCount      Int      @default(0)
  corroboratedEdgeCount   Int      @default(0)
  claimedEdgeCount        Int      @default(0)
  observedEdgeCount       Int      @default(0)
  inferredEdgeCount       Int      @default(0)
  contradictedEdgeCount   Int      @default(0)
  sourceDiversity         Int      @default(0)
  evidenceCoverage        Float    @default(0.0)
  identityConfidence      Float    @default(0.0)
  temporalCoverage        Float    @default(0.0)
  pathCount               Int      @default(0)
  alternatePathCount      Int      @default(0)
  criticalUnknownCount    Int      @default(0)
  overallConfidence       Float    @default(0.0)
  nodeCompleteness        Float    @default(0.0)
  edgeCompleteness        Float    @default(0.0)
  evidenceCompleteness    Float    @default(0.0)
  identityCompleteness    Float    @default(0.0)
  temporalCompleteness    Float    @default(0.0)
  calculatedAt            DateTime @default(now())
  validFrom               DateTime?
  validTo                 DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant                  Tenant                    @relation(fields: [tenantId], references: [id])
  decisions               SupplyChainDecision[]
  verifications           SupplyChainVerification[]

  @@unique([tenantId, subjectType, subjectId, version])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, subjectType, subjectId])
  @@index([tenantId, overallConfidence])
  @@index([tenantId, algorithmVersion])
  @@index([inputHash])
  @@index([calculatedAt])
  @@map("supply_chain_assessments")
}

// ─── Supply-Chain Decision ────────────────────────────────────────────────────
// Immutable calculation snapshot preserving exact inputs and outputs.

model SupplyChainDecision {
  id                      String   @id @default(cuid())
  assessmentId            String
  algorithmVersion        String
  evidenceStrengthScore   Float    @default(0)
  independenceScore       Float    @default(0)
  identityScore           Float    @default(0)
  directnessScore         Float    @default(0)
  corroborationScore      Float    @default(0)
  freshnessScore          Float    @default(0)
  contradictionPenalty    Float    @default(0)
  completenessScore       Float    @default(0)
  finalConfidence         Float
  inputHash               String
  edgeIds                 Json     @default("[]")
  evidenceIds             Json     @default("[]")
  observationIds          Json     @default("[]")
  calculatedAt            DateTime @default(now())

  assessment              SupplyChainAssessment @relation(fields: [assessmentId], references: [id])

  @@index([assessmentId])
  @@index([calculatedAt])
  @@index([algorithmVersion])
  @@unique([assessmentId, inputHash])
  @@map("supply_chain_decisions")
}

// ─── Supply-Chain Verification ────────────────────────────────────────────────
// Verification requirements for unresolved supply-chain links.

model SupplyChainVerification {
  id                String   @id @default(cuid())
  tenantId          String
  assessmentId      String
  verificationType  String // VERIFY_SUPPLIER_AUTHORIZATION | VERIFY_MANUFACTURER_RELATIONSHIP | VERIFY_EXPORTER_IDENTITY | VERIFY_IMPORTER_IDENTITY | VERIFY_ORIGIN | VERIFY_TRADE_ROUTE | VERIFY_BANGLADESH_DISTRIBUTOR
  priority          String // low | medium | high | critical
  reason            String
  targetNodeType    String?
  targetNodeId      String?
  targetEdgeType    String?
  targetEdgeId      String?
  existingEvidence  Json     @default("[]")
  missingEvidence   Json     @default("[]")
  importance        Float    @default(0.5)
  createdAt         DateTime @default(now())

  tenant            Tenant                    @relation(fields: [tenantId], references: [id])
  assessment        SupplyChainAssessment     @relation(fields: [assessmentId], references: [id])

  @@index([tenantId])
  @@index([assessmentId])
  @@index([verificationType])
  @@index([priority])
  @@map("supply_chain_verifications")
}

// ─── Supply-Chain Claim ───────────────────────────────────────────────────────
// Supplier/party claims stored separately from verified relationships.
// Claims are NEVER automatically promoted to confirmed facts.

model SupplyChainClaim {
  id              String   @id @default(cuid())
  tenantId        String
  claimType       String // AUTHORIZED_DISTRIBUTOR | FACTORY_DIRECT | OFFICIAL_IMPORTER | MANUFACTURER | EXCLUSIVE_DISTRIBUTOR | OEM_MANUFACTURER | ORIGINAL_SUPPLIER
  claimText       String
  claimingNodeId  String
  targetNodeId    String
  sourceId        String
  evidenceId      String?
  observedAt      DateTime @default(now())
  retrievedAt     DateTime @default(now())
  status          String   @default("UNVERIFIED") // UNVERIFIED | UNDER_REVIEW | VERIFIED | REJECTED
  verifiedAt      DateTime?
  verifiedBy      String?
  validFrom       DateTime?
  validTo         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  claimingNode    SupplyChainNode     @relation("ClaimClaiming", fields: [claimingNodeId], references: [id])
  targetNode      SupplyChainNode     @relation("ClaimTarget", fields: [targetNodeId], references: [id])

  @@index([tenantId])
  @@index([claimingNodeId])
  @@index([targetNodeId])
  @@index([claimType])
  @@index([status])
  @@index([observedAt])
  @@map("supply_chain_claims")
}

// ─── Supply-Chain Anomaly ─────────────────────────────────────────────────────
// Detected graph anomalies: invalid relationships, self-loops, contradictions,
// suspicious shortcuts, cycles.

model SupplyChainAnomaly {
  id              String   @id @default(cuid())
  tenantId        String
  anomalyType     String // INVALID_RELATIONSHIP | SELF_LOOP | CONTRADICTORY_MANUFACTURER | CONTRADICTORY_ORIGIN | TEMPORAL_OVERLAP | SUSPICIOUS_SHORTCUT | CYCLE_DETECTED
  severity        String // low | medium | high | critical
  description     String
  nodeId          String?
  edgeId          String?
  involvedNodeIds Json     @default("[]")
  involvedEdgeIds Json     @default("[]")
  status          String   @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED | DISMISSED
  resolvedAt      DateTime?
  resolvedBy      String?
  resolution      String?
  detectedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([anomalyType])
  @@index([severity])
  @@index([status])
  @@index([detectedAt])
  @@map("supply_chain_anomalies")
}

// =============================================================================
// PHASE 10: LOGISTICS & ROUTING INTELLIGENCE ENGINE
// =============================================================================

enum LogisticsNodeType {
  ORIGIN
  DESTINATION
  PORT
  AIRPORT
  BORDER_CROSSING
  WAREHOUSE
  DISTRIBUTION_CENTER
  TRANSLOAD_HUB
  CONSOLIDATION_HUB
  DECONSOLIDATION_HUB
  FULFILLMENT_CENTER
  MANUFACTURER_LOCATION
  SUPPLIER_LOCATION
  EXPORTER_LOCATION
  IMPORTER_LOCATION
  BANGLADESH_DISTRIBUTION_POINT
  BANGLADESH_WAREHOUSE
  BANGLADESH_MARKET
  CUSTOMS_POINT
  OTHER_LOGISTICS_NODE
}

enum LogisticsLegType {
  ROAD
  RAIL
  SEA
  AIR
  INLAND_WATERWAY
  MULTIMODAL
  COURIER
  PARCEL
  TRUCK
  CONTAINER
  OTHER
}

enum LogisticsRouteStatus {
  OBSERVED
  CLAIMED
  INFERRED
  CORROBORATED
  CONFIRMED
  CONTRADICTED
  UNKNOWN
}

enum LogisticsAvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  UNKNOWN
  UNRESOLVED
}

enum LogisticsConflictResolutionState {
  OPEN
  RESOLVED
  SUPERSEDED
  UNRESOLVED
}

// ─── Logistics Node ───────────────────────────────────────────────────────────
// Represents a physical or logical point in the logistics graph.
// References existing canonical entities via polymorphic canonicalEntityType/canonicalEntityId.

model LogisticsNode {
  id                  String            @id @default(cuid())
  tenantId            String
  nodeType            LogisticsNodeType
  name                String
  normalizedName      String
  canonicalEntityType String? // supplyChainNode | product | brand | seller | supplier | manufacturer | organization
  canonicalEntityId   String?
  sourceEntityId      String? // external ID from a source
  sourceId            String?
  country             String? // ISO 3166-1 alpha-2
  region              String?
  city                String?
  unLocode            String? // UN/LOCODE for ports
  iataCode            String? // IATA code for airports
  icaoCode            String? // ICAO code for airports
  operationalStatus   LogisticsAvailabilityStatus @default(UNKNOWN)
  customsCapability   Boolean           @default(false)
  timezone            String?
  identityStatus      String            @default("unresolved") // resolved | high_confidence | possible | ambiguous | conflict | unresolved
  identityConfidence  Float             @default(0.0)
  metadata            Json              @default("{}")
  observedAt          DateTime          @default(now())
  retrievedAt         DateTime          @default(now())
  validFrom           DateTime?
  validTo             DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  legsFrom            LogisticsLeg[]      @relation("LegFromNode")
  legsTo              LogisticsLeg[]      @relation("LegToNode")
  conflicts           LogisticsConflict[]

  @@unique([tenantId, nodeType, normalizedName, sourceId])
  @@index([tenantId])
  @@index([nodeType])
  @@index([canonicalEntityType, canonicalEntityId])
  @@index([normalizedName])
  @@index([identityStatus])
  @@index([country])
  @@index([operationalStatus])
  @@map("logistics_nodes")
}

// ─── Logistics Leg ────────────────────────────────────────────────────────────
// Represents a transport movement between two logistics nodes.

model LogisticsLeg {
  id                  String            @id @default(cuid())
  tenantId            String
  fromNodeId          String
  toNodeId            String
  legType             LogisticsLegType
  carrierOrganizationId String? // reference to canonical Organization
  carrierName         String?
  serviceType         String?
  legStatus           LogisticsRouteStatus @default(UNKNOWN)
  confidence          Float             @default(0.0)
  evidenceStrength    Float             @default(0.0)
  sourceDiversity     Int               @default(0)
  evidenceCount       Int               @default(0)
  observationCount    Int               @default(0)
  isContradicted      Boolean           @default(false)
  contradictionCount  Int               @default(0)
  transitTimeMinHours Int? // minimum transit time in hours
  transitTimeMaxHours Int? // maximum transit time in hours
  transitTimeKnown    Boolean           @default(false)
  frequencyPerWeek    Float?
  cutoffInfo          String?
  capacityInfo        String?
  restrictions        Json              @default("[]")
  contentHash         String? // SHA-256 of canonical inputs for dedup
  algorithmVersion    String            @default("LOGISTICS_ALGORITHM_V1")
  observedAt          DateTime          @default(now())
  validFrom           DateTime?
  validTo             DateTime?
  metadata            Json              @default("{}")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  fromNode            LogisticsNode       @relation("LegFromNode", fields: [fromNodeId], references: [id])
  toNode              LogisticsNode       @relation("LegToNode", fields: [toNodeId], references: [id])
  observations        LogisticsObservation[]
  evidenceLinks       LogisticsEvidenceLink[]
  conflicts           LogisticsConflict[]

  @@unique([tenantId, fromNodeId, toNodeId, legType, contentHash])
  @@index([tenantId])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([legType])
  @@index([legStatus])
  @@index([contentHash])
  @@index([confidence])
  @@index([isContradicted])
  @@index([validFrom, validTo])
  @@map("logistics_legs")
}

// ─── Logistics Route ──────────────────────────────────────────────────────────
// An ordered sequence of logistics legs forming a complete path from origin to destination.
// First-class entity with versioning, evidence, and temporal validity.

model LogisticsRoute {
  id                      String              @id @default(cuid())
  tenantId                String
  originNodeId            String
  destinationNodeId       String
  legIds                  Json                @default("[]") // ordered array of leg IDs
  routeStatus             LogisticsRouteStatus @default(UNKNOWN)
  totalTransitMinHours    Int? // sum of known min transit times
  totalTransitMaxHours    Int? // sum of known max transit times
  transitTimeKnown        Boolean             @default(false)
  legCount                Int                 @default(0)
  transshipmentCount      Int                 @default(0)
  modeChangeCount         Int                 @default(0)
  confidence              Float               @default(0.0)
  completeness            Float               @default(0.0)
  evidenceCoverage        Float               @default(0.0)
  riskSummary             Json                @default("{}") // { totalRisks, criticalRisks, highRisks }
  contentHash             String? // SHA-256 of canonical inputs
  algorithmVersion        String              @default("LOGISTICS_ALGORITHM_V1")
  assumptions             Json                @default("[]")
  unresolvedRequirements  Json                @default("[]")
  observedAt              DateTime            @default(now())
  validFrom               DateTime?
  validTo                 DateTime?
  metadata                Json                @default("{}")
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  tenant                  Tenant              @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, originNodeId, destinationNodeId, contentHash])
  @@index([tenantId])
  @@index([originNodeId])
  @@index([destinationNodeId])
  @@index([routeStatus])
  @@index([contentHash])
  @@index([confidence])
  @@index([validFrom, validTo])
  @@map("logistics_routes")
}

// ─── Logistics Observation ────────────────────────────────────────────────────
// Immutable record of a logistics fact observed from a source.
// NEVER overwritten — new information creates new observations.

model LogisticsObservation {
  id                  String   @id @default(cuid())
  tenantId            String
  legId               String?
  routeId             String? // optional: link to route if observation is route-level
  nodeId              String? // optional: link to node if observation is node-level
  sourceId            String
  evidenceId          String? // link to Phase 6 Evidence
  observationType     String // ROUTE_AVAILABLE | TRANSIT_TIME | CARRIER_CLAIM | PORT_STATUS | BORDER_CONDITION | MODE_AVAILABILITY | CAPACITY | RESTRICTION | CUSTOMS_INFO | OTHER
  observationStatus   String   @default("observed") // observed | inferred | probable | unknown
  observedValue       Json     // what was observed
  contentHash         String   // SHA-256 for dedup
  observedAt          DateTime
  retrievedAt         DateTime
  validFrom           DateTime?
  validTo             DateTime?
  parserVersion       String?
  createdAt           DateTime @default(now())

  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  leg                 LogisticsLeg?       @relation(fields: [legId], references: [id])
  source              Source              @relation(fields: [sourceId], references: [id])
  evidence            Evidence?           @relation(fields: [evidenceId], references: [id])

  @@unique([tenantId, legId, sourceId, contentHash])
  @@index([tenantId])
  @@index([legId])
  @@index([routeId])
  @@index([nodeId])
  @@index([sourceId])
  @@index([evidenceId])
  @@index([contentHash])
  @@index([observedAt])
  @@index([observationType])
  @@index([observationStatus])
  @@map("logistics_observations")
}

// ─── Logistics Evidence Link ──────────────────────────────────────────────────
// Links a leg to existing Phase 6 Evidence records with role tracking.

model LogisticsEvidenceLink {
  id              String   @id @default(cuid())
  tenantId        String
  legId           String
  evidenceId      String // link to existing Phase 6 Evidence
  evidenceRole    String // SUPPORTING | CONTRADICTING | CONTEXTUAL | UNRESOLVED
  evidenceStrength String // DIRECT | STRONG | MODERATE | WEAK | CONTEXTUAL
  relevance       Float    @default(1.0)
  effect          Float    @default(0.0)
  sourceId        String?
  observedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  leg             LogisticsLeg        @relation(fields: [legId], references: [id])
  evidence        Evidence            @relation("LogisticsEvidenceLink", fields: [evidenceId], references: [id])

  @@unique([legId, evidenceId])
  @@index([tenantId])
  @@index([legId])
  @@index([evidenceId])
  @@index([evidenceRole])
  @@map("logistics_evidence_links")
}

// ─── Logistics Conflict ───────────────────────────────────────────────────────
// Contradictory logistics information: conflicting transit times, carrier claims,
// route availability, node status, temporal validity.

model LogisticsConflict {
  id                      String    @id @default(cuid())
  tenantId                String
  legId                   String?
  nodeId                  String?
  routeId                 String?
  conflictType            String // CONTRADICTORY_TRANSIT_TIME | CONTRADICTORY_CARRIER | CONTRADICTORY_ROUTE_AVAILABILITY | CONTRADICTORY_NODE_STATUS | CONTRADICTORY_TEMPORAL | CONTRADICTORY_CAPACITY | CONTRADICTORY_EVIDENCE
  severity                String // low | medium | high | critical
  description             String
  supportingEvidenceId    String
  contradictingEvidenceId String
  resolutionState         LogisticsConflictResolutionState @default(OPEN)
  resolvedAt              DateTime?
  resolvedBy              String?
  resolution              String?
  resolutionEvidenceId    String?
  detectedAt              DateTime  @default(now())
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tenant                  Tenant              @relation(fields: [tenantId], references: [id])
  leg                     LogisticsLeg?       @relation(fields: [legId], references: [id])
  node                    LogisticsNode?      @relation(fields: [nodeId], references: [id])

  @@index([tenantId])
  @@index([legId])
  @@index([nodeId])
  @@index([routeId])
  @@index([conflictType])
  @@index([severity])
  @@index([resolutionState])
  @@index([detectedAt])
  @@map("logistics_conflicts")
}

// ─── Logistics Assessment ─────────────────────────────────────────────────────
// Deterministic summary of logistics graph state for a subject entity.
// Immutable snapshots — new calculations create new records with incremented version.

model LogisticsAssessment {
  id                      String   @id @default(cuid())
  tenantId                String
  subjectType             String // PRODUCT | SKU | SELLER | SUPPLIER | BRAND | ORGANIZATION | ROUTE
  subjectId               String
  status                  String   @default("PENDING") // PENDING | COMPLETE | STALE | CONTRADICTED | INSUFFICIENT
  algorithmVersion        String   @default("LOGISTICS_ALGORITHM_V1")
  inputHash               String // SHA-256 of canonical inputs — deterministic fingerprint
  version                 Int      @default(1) // monotonically increasing per subject
  routeCount              Int      @default(0)
  legCount                Int      @default(0)
  nodeCount               Int      @default(0)
  knownLegCount           Int      @default(0)
  unknownLegCount         Int      @default(0)
  confirmedLegCount       Int      @default(0)
  contradictedLegCount    Int      @default(0)
  sourceDiversity         Int      @default(0)
  evidenceCoverage        Float    @default(0.0)
  overallConfidence       Float    @default(0.0)
  nodeCompleteness        Float    @default(0.0)
  legCompleteness         Float    @default(0.0)
  evidenceCompleteness    Float    @default(0.0)
  temporalCompleteness    Float    @default(0.0)
  routeCompleteness       Float    @default(0.0)
  riskCount               Int      @default(0)
  anomalyCount            Int      @default(0)
  conflictCount           Int      @default(0)
  calculatedAt            DateTime @default(now())
  validFrom               DateTime?
  validTo                 DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant                  Tenant              @relation(fields: [tenantId], references: [id])
  decisions               LogisticsDecision[]
  risks                   LogisticsRisk[]
  anomalies               LogisticsAnomaly[]

  @@unique([tenantId, subjectType, subjectId, version])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, subjectType, subjectId])
  @@index([tenantId, overallConfidence])
  @@index([tenantId, algorithmVersion])
  @@index([inputHash])
  @@index([calculatedAt])
  @@map("logistics_assessments")
}

// ─── Logistics Decision ───────────────────────────────────────────────────────
// Immutable calculation snapshot preserving exact inputs and outputs.

model LogisticsDecision {
  id                      String   @id @default(cuid())
  assessmentId            String
  algorithmVersion        String
  evidenceStrengthScore   Float    @default(0)
  independenceScore       Float    @default(0)
  carrierConfidenceScore  Float    @default(0)
  directnessScore         Float    @default(0)
  corroborationScore      Float    @default(0)
  freshnessScore          Float    @default(0)
  contradictionPenalty    Float    @default(0)
  completenessScore       Float    @default(0)
  finalConfidence         Float
  inputHash               String
  legIds                  Json     @default("[]")
  routeIds                Json     @default("[]")
  evidenceIds             Json     @default("[]")
  observationIds          Json     @default("[]")
  calculatedAt            DateTime @default(now())

  assessment              LogisticsAssessment @relation(fields: [assessmentId], references: [id])

  @@index([assessmentId])
  @@index([calculatedAt])
  @@index([algorithmVersion])
  @@unique([assessmentId, inputHash])
  @@map("logistics_decisions")
}

// ─── Logistics Risk ───────────────────────────────────────────────────────────
// Structured logistics risk records. Risk is independent from confidence.

model LogisticsRisk {
  id              String   @id @default(cuid())
  tenantId        String
  assessmentId    String
  riskType        String // EXCESSIVE_TRANSSHIPMENTS | EXCESSIVE_MODE_CHANGES | MISSING_LEG | UNKNOWN_TRANSIT_TIME | LOW_EVIDENCE_COVERAGE | STALE_OBSERVATION | CONTRADICTORY_EVIDENCE | ROUTE_CYCLE | UNAVAILABLE_NODE | UNAVAILABLE_MODE | BORDER_CUSTOMS_UNCERTAINTY | CARRIER_UNCERTAINTY | DESTINATION_UNCERTAINTY | ORIGIN_UNCERTAINTY | TEMPORAL_CONFLICT | ROUTE_COMPLETENESS_FAILURE
  severity        String // low | medium | high | critical
  description     String
  legId           String?
  nodeId          String?
  routeId         String?
  metadata        Json     @default("{}")
  detectedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  assessment      LogisticsAssessment @relation(fields: [assessmentId], references: [id])

  @@index([tenantId])
  @@index([assessmentId])
  @@index([riskType])
  @@index([severity])
  @@index([detectedAt])
  @@map("logistics_risks")
}

// ─── Logistics Anomaly ────────────────────────────────────────────────────────
// Detected graph anomalies: self-loops, cycles, invalid transitions, disconnected
// routes, contradictory timing, stale routes, unsupported modes.

model LogisticsAnomaly {
  id              String   @id @default(cuid())
  tenantId        String
  anomalyType     String // SELF_LOOP | CYCLE_DETECTED | INVALID_MODE_NODE_COMBINATION | IMPOSSIBLE_TRANSITION | MISSING_ORIGIN | MISSING_DESTINATION | DUPLICATE_LEG | SUSPICIOUS_SHORTCUT | CONTRADICTORY_TIMING | STALE_ROUTE | DISCONNECTED_ROUTE | UNSUPPORTED_TRANSPORT_MODE
  severity        String // low | medium | high | critical
  description     String
  nodeId          String?
  legId           String?
  routeId         String?
  involvedNodeIds Json     @default("[]")
  involvedLegIds  Json     @default("[]")
  status          String   @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED | DISMISSED
  resolvedAt      DateTime?
  resolvedBy      String?
  resolution      String?
  detectedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  assessment      LogisticsAssessment @relation(fields: [assessmentId], references: [id])
  assessmentId    String

  @@index([tenantId])
  @@index([anomalyType])
  @@index([severity])
  @@index([status])
  @@index([detectedAt])
  @@map("logistics_anomalies")
}

// =============================================================================
// PHASE 11: LANDED COST, PRICING & MARGIN INTELLIGENCE ENGINE
// =============================================================================

enum PricingSourceType {
  SUPPLIER_QUOTE
  MARKETPLACE_LISTING
  WHOLESALE
  RETAIL
  DISTRIBUTOR
  CUSTOMS_DECLARATION
  TRADE_DATA
  OTHER
}

enum PriceObservationType {
  PRODUCT_COST
  FREIGHT
  INSURANCE
  DUTY
  TAX
  PORT_CHARGE
  CUSTOMS_FEE
  CLEARING_FEE
  INLAND_TRANSPORT
  WAREHOUSE
  PLATFORM_FEE
  COMMISSION
  MARKETING
  DELIVERY
  SELLING_PRICE
  COMPETITOR_PRICE
  EXCHANGE_RATE
  OTHER
}

enum PriceBasis {
  UNIT
  PACK
  CASE
  CARTON
  PALLET
  CONTAINER
  KG
  LITER
  OTHER
}

enum CostComponentType {
  PRODUCT_COST
  PACKAGING
  INLAND_ORIGIN
  EXPORT_HANDLING
  FREIGHT
  INSURANCE
  PORT
  CUSTOMS
  DUTY
  VAT
  AIT
  ATV
  CD
  SD
  RD
  CLEARING
  INLAND_BANGLADESH
  WAREHOUSE
  PAYMENT
  PLATFORM
  OTHER
}

enum CostStatus {
  OBSERVED
  ESTIMATED
  UNKNOWN
  DISPUTED
  EXPIRED
}

enum PricingCalculationStatus {
  PENDING
  COMPLETE
  STALE
  CONTRADICTED
  INSUFFICIENT
}

enum MarginType {
  GROSS_PROFIT
  GROSS_MARGIN
