  NARROW_MARGIN_RANGE
}

enum PriceTrendDirection {
  RISING
  STABLE
  DECLINING
  VOLATILE
  UNKNOWN
}

enum PriceConfidenceBand {
  HIGH
  MEDIUM
  LOW
  INSUFFICIENT_DATA
}

enum PricePositionType {
  BELOW_MARKET
  LOWER_MARKET
  MID_MARKET
  UPPER_MARKET
  ABOVE_MARKET
  UNKNOWN
}

// ─── Price Observation ──────────────────────────────────────────────────────
// Immutable record of an observed price from an external source.
// NEVER overwritten — new information creates new observations.

model PriceObservation {
  id                  String            @id @default(cuid())
  tenantId            String
  productId           String
  supplierId          String?           // canonical Supplier ID (indexed, not FK)
  sourceType          PricingSourceType
  observationType     PriceObservationType
  price               Float
  currency            String            // ISO 4217: USD, BDT, EUR, etc.
  quantity            Float?
  moq                 Float?
  priceBasis          PriceBasis        @default(UNIT)
  market              String?           // e.g. "alibaba", "daraz", "wholesale_dhaka"
  country             String?           // ISO 3166-1 alpha-2
  sourceUrl           String?
  observedAt          DateTime
  validUntil          DateTime?
  evidenceId          String?           // Phase 6 Evidence ID (not FK)
  normalizedUnitPrice Float?
  normalizedCurrency  String?
  exchangeRateEvidenceId String?        // exchange rate evidence reference
  exchangeRateObservedAt DateTime?
  packSize            Float?
  perUnitQuantity     Float?
  metadata            Json              @default("{}")
  contentHash         String            // SHA-256 of canonical inputs
  parserVersion       String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tenant              Tenant            @relation(fields: [tenantId], references: [id])
  product             Product           @relation(fields: [productId], references: [id])

  @@unique([tenantId, productId, sourceType, observationType, contentHash])
  @@index([tenantId])
  @@index([productId])
  @@index([supplierId])
  @@index([sourceType])
  @@index([observationType])
  @@index([contentHash])
  @@index([observedAt])
  @@index([currency])
  @@index([market])
  @@index([country])
  @@index([evidenceId])
  @@map("price_observations")
}

// ─── Cost Component ─────────────────────────────────────────────────────────
// One component of landed cost. Each component has its own evidence and status.
// Unknown components have status=UNKNOWN and amount=0 with explicit UNKNOWN flag.

model CostComponent {
  id                  String            @id @default(cuid())
  tenantId            String
  productId           String
  supplierId          String?           // canonical Supplier ID (indexed, not FK)
  logisticsRouteId    String?           // Phase 10 LogisticsRoute ID (indexed, not FK)
  type                CostComponentType
  amount              Float
  currency            String            // ISO 4217
  basis               PriceBasis        @default(UNIT)
  quantity            Float?
  rate                Float?            // e.g. duty rate as percentage
  rateType            String?           // AD_VALOREM | SPECIFIC | COMPOUND
  status              CostStatus        @default(OBSERVED)
  evidenceId          String?           // Phase 6 Evidence ID (not FK)
  observedAt          DateTime?
  validFrom           DateTime?
  validTo             DateTime?
  metadata            Json              @default("{}")
  contentHash         String            // SHA-256 of canonical inputs
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tenant              Tenant            @relation(fields: [tenantId], references: [id])
  product             Product           @relation(fields: [productId], references: [id])

  @@unique([tenantId, productId, type, supplierId, logisticsRouteId, contentHash])
  @@index([tenantId])
  @@index([productId])
  @@index([supplierId])
  @@index([logisticsRouteId])
  @@index([type])
  @@index([status])
  @@index([contentHash])
  @@index([observedAt])
  @@map("cost_components")
}

// ─── Landed Cost Calculation ────────────────────────────────────────────────
// Complete cost calculation aggregating all cost components.
// Immutable snapshot — new calculations create new records with incremented version.

model LandedCostCalculation {
  id                    String                  @id @default(cuid())
  tenantId              String
  productId             String
  supplierId            String?
  logisticsRouteId      String?
  quantity              Float
  currency              String                  // ISO 4217
  // Cost breakdowns (0.0 when unknown; unknownComponentFlags tracks which are UNKNOWN)
  productCost           Float                   @default(0)
  originCosts           Float                   @default(0)
  freightCost           Float                   @default(0)
  insuranceCost         Float                   @default(0)
  dutyCost              Float                   @default(0)
  taxCost               Float                   @default(0)
  portCost              Float                   @default(0)
  customsCost           Float                   @default(0)
  clearingCost          Float                   @default(0)
  destinationCost       Float                   @default(0)
  otherCost             Float                   @default(0)
  totalCost             Float                   @default(0)
  unitLandedCost        Float?                  // null when quantity unknown or total unknown
  // Status tracks which components are known/unknown
  status                PricingCalculationStatus @default(PENDING)
  unknownComponentFlags Json                    @default("[]") // ["FREIGHT", "DUTY"] etc.
  // Quality dimensions
  confidence            Float                   @default(0)
  completeness          Float                   @default(0)
  // Provenance
  componentIds          Json                    @default("[]") // CostComponent IDs used
  observationIds        Json                    @default("[]") // PriceObservation IDs used
  exchangeRateEvidenceId String?
  exchangeRateUsed      Float?
  algorithmVersion      String                  @default("PRICING_ALGORITHM_V1")
  inputHash             String                  // SHA-256 of canonical inputs
  version               Int                     @default(1)
  calculatedAt          DateTime                @default(now())
  validFrom             DateTime?
  validTo               DateTime?
  contentHash           String                  // SHA-256 of semantic inputs
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  tenant                Tenant                  @relation(fields: [tenantId], references: [id])
  product               Product                 @relation(fields: [productId], references: [id])
  scenarios             PricingScenario[]

  @@unique([tenantId, productId, supplierId, logisticsRouteId, version])
  @@index([tenantId])
  @@index([productId])
  @@index([supplierId])
  @@index([logisticsRouteId])
  @@index([status])
  @@index([inputHash])
  @@index([contentHash])
  @@index([calculatedAt])
  @@index([version])
  @@map("landed_cost_calculations")
}

// ─── Pricing Scenario ───────────────────────────────────────────────────────
// A potential Bangladesh commercial configuration built on top of a landed cost.
// Immutable snapshot — new scenarios create new records.

model PricingScenario {
  id                    String              @id @default(cuid())
  tenantId              String
  productId             String
  landedCostCalculationId String
  scenarioType          PriceScenarioType
  sellingPrice          Float?
  currency              String              // ISO 4217
  // Selling cost breakdown
  platformFees          Float               @default(0)
  salesCommission       Float               @default(0)
  marketingCost         Float               @default(0)
  warehouseCost         Float               @default(0)
  deliveryCost          Float               @default(0)
  otherSellingCost      Float               @default(0)
  // Calculated margins
  totalVariableCost     Float?              // landed cost + all selling costs
  grossProfit           Float?              // sellingPrice - totalVariableCost
  grossMargin           Float?              // grossProfit / sellingPrice
  markup                Float?              // grossProfit / landedCost
  breakEvenPrice        Float?              // minimum viable selling price
  targetMargin          Float?              // user-specified target margin
  targetPrice           Float?              // price for target margin
  pricePosition         PricePositionType   @default(UNKNOWN)
  // Quality dimensions
  confidence            Float               @default(0)
  completeness          Float               @default(0)
  status                PricingCalculationStatus @default(PENDING)
  unknownInputFlags     Json                @default("[]") // ["SELLING_PRICE", "PLATFORM_FEES"] etc.
  // Provenance
  observationIds        Json                @default("[]")
  algorithmVersion      String              @default("PRICING_ALGORITHM_V1")
  contentHash           String              // SHA-256 of semantic inputs
  calculatedAt          DateTime            @default(now())
  validFrom             DateTime?
  validTo               DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  tenant                Tenant                @relation(fields: [tenantId], references: [id])
  product               Product               @relation(fields: [productId], references: [id])
  landedCostCalculation LandedCostCalculation @relation(fields: [landedCostCalculationId], references: [id])

  @@unique([tenantId, productId, landedCostCalculationId, scenarioType, contentHash])
  @@index([tenantId])
  @@index([productId])
  @@index([landedCostCalculationId])
  @@index([scenarioType])
  @@index([status])
  @@index([contentHash])
  @@index([calculatedAt])
  @@map("pricing_scenarios")
}

// ─── Market Price Snapshot ──────────────────────────────────────────────────
// Aggregated market price statistics for a product in a specific market.
// Immutable snapshot — new aggregations create new records.

model MarketPriceSnapshot {
  id                String              @id @default(cuid())
  tenantId          String
  productId         String
  market            String              // e.g. "daraz", "wholesale_dhaka", "retail_bd"
  country           String              @default("BD")
  currency          String              // ISO 4217
  // Statistical aggregation
  observationCount  Int
  comparableCount   Int
  incomparableCount Int
  minPrice          Float?
  maxPrice          Float?
  medianPrice       Float?
  averagePrice      Float?
  lowerQuartile     Float?
  upperQuartile     Float?
  priceSpread       Float?              // maxPrice - minPrice
  spreadPercentage  Float?              // spread / medianPrice
  trendDirection    PriceTrendDirection @default(UNKNOWN)
  priceVolatility   Float?              // coefficient of variation
  // Quality dimensions
  confidence        Float               @default(0)
  completeness      Float               @default(0)
  // Provenance
  observationIds    Json                @default("[]")
  contentHash       String              // SHA-256 of canonical inputs
  algorithmVersion  String              @default("PRICING_ALGORITHM_V1")
  snapshotDate      DateTime            @default(now())
  validFrom         DateTime?
  validTo           DateTime?
  createdAt         DateTime            @default(now())

  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  product           Product             @relation(fields: [productId], references: [id])

  @@unique([tenantId, productId, market, snapshotDate, contentHash])
  @@index([tenantId])
  @@index([productId])
  @@index([market])
  @@index([country])
  @@index([snapshotDate])
  @@index([contentHash])
  @@index([trendDirection])
  @@map("market_price_snapshots")
}

// ─── Pricing Risk ───────────────────────────────────────────────────────────
// Detected commercial risk. Each risk has explicit trigger, evidence, and affected input.
// Risk is independent from confidence — a high-confidence calculation can have high risk.

model PricingRisk {
  id              String          @id @default(cuid())
  tenantId        String
  assessmentId    String
  riskType        PricingRiskType
  severity        String          // low | medium | high | critical
  description     String
  trigger         String          // what triggered this risk detection
  affectedInput   String          // which input/field is affected
  affectedEntityId String?        // product/supplier/route ID
  affectedEntityType String?      // product | supplier | route | observation
  evidence        Json            @default("{}") // supporting evidence references
  metadata        Json            @default("{}")
  detectedAt      DateTime        @default(now())
  createdAt       DateTime        @default(now())

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  assessment      PricingAssessment   @relation(fields: [assessmentId], references: [id])

  @@index([tenantId])
  @@index([assessmentId])
  @@index([riskType])
  @@index([severity])
  @@index([detectedAt])
  @@map("pricing_risks")
}

// ─── Pricing Assessment ─────────────────────────────────────────────────────
// Deterministic summary of pricing intelligence state for a product.
// Immutable snapshot — new assessments create new records with incremented version.

model PricingAssessment {
  id                      String                  @id @default(cuid())
  tenantId                String
  productId               String
  supplierId              String?
  status                  PricingCalculationStatus @default(PENDING)
  algorithmVersion        String                  @default("PRICING_ALGORITHM_V1")
  inputHash               String                  // SHA-256 of canonical inputs
  version                 Int                     @default(1)
  // Summary counts
  observationCount        Int                     @default(0)
  costComponentCount      Int                     @default(0)
  landedCostCount         Int                     @default(0)
  scenarioCount           Int                     @default(0)
  marketSnapshotCount     Int                     @default(0)
  riskCount               Int                     @default(0)
  // Quality dimensions
  overallConfidence       Float                   @default(0)
  overallCompleteness     Float                   @default(0)
  overallPriceVolatility  Float?
  overallTrendDirection   PriceTrendDirection     @default(UNKNOWN)
  // Provenance
  landedCostIds           Json                    @default("[]")
  scenarioIds             Json                    @default("[]")
  marketSnapshotIds       Json                    @default("[]")
  observationIds          Json                    @default("[]")
  calculatedAt            DateTime                @default(now())
  validFrom               DateTime?
  validTo                 DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  tenant                  Tenant              @relation(fields: [tenantId], references: [id])
  risks                   PricingRisk[]

  @@unique([tenantId, productId, supplierId, version])
  @@index([tenantId])
  @@index([productId])
  @@index([supplierId])
  @@index([status])
  @@index([overallConfidence])
  @@index([inputHash])
  @@index([calculatedAt])
  @@index([version])
  @@map("pricing_assessments")
}

// =============================================================================
// PHASE 12 — PRODUCT OPPORTUNITY, COMPETITION & RESELLER VIABILITY INTELLIGENCE
// =============================================================================
// Phase 12 consumes Phases 7-11 to produce evidence-backed opportunity factors,
// competitive structure, economics, uncertainty, and operational constraints.
// Does NOT make reseller decisions — exposes measurable dimensions.
//
// Key invariants:
// - Evidence-backed: every metric traceable to source evidence
// - Deterministic: same inputs → identical outputs
// - Unknown ≠ Zero: missing data propagates as UNKNOWN
// - No hidden recommendations: no BUY/BEST/WINNER verdicts
// - Contradictions preserved: conflicting observations remain traceable
// =============================================================================

// ─── Phase 12 Enums ──────────────────────────────────────────────────────────

enum ProductOppSignalType {
  STRONG_DEMAND_GROWTH
  WEAK_DEMAND
  DEMAND_DECLINE
  DEMAND_VOLATILITY
  SEASONALITY_DETECTED
  LOW_COMPETITOR_DENSITY
  HIGH_COMPETITION
  MARKET_SATURATION
  PRICE_COMPRESSION
  WIDE_PRICE_SPREAD
  HIGH_PRICE_VOLATILITY
  MULTIPLE_SUPPLIER_OPTIONS
  HIGH_SUPPLIER_CONCENTRATION
  SUPPLIER_DIVERSITY
  HIGH_LOGISTICS_COMPLEXITY
  LOGISTICS_UNCERTAINTY
  NARROW_MARGIN_RANGE
  LOW_MARGIN
  HIGH_LANDED_COST
  LOW_DATA_COMPLETENESS
  SPECIFICATION_AMBIGUITY
  PRICE_ANOMALY
}

enum CompetitionLevel {
  VERY_LOW
  LOW
  MODERATE
  HIGH
  VERY_HIGH
  UNKNOWN
}

enum CompetitionStructure {
  MONOPOLY
  DUOPOLY
  OLIGOPOLY
  COMPETITIVE
  FRAGMENTED
  UNKNOWN
}

enum DemandMomentum {
  ACCELERATING
  GROWING
  STABLE
  DECLINING
  VOLATILE
  UNKNOWN
}

enum MarketSaturationLevel {
  LOW
  MODERATE
  HIGH
  VERY_HIGH
  UNKNOWN
}

enum SupplierConcentrationLevel {
  DIVERSIFIED
  MODERATELY_CONCENTRATED
  CONCENTRATED
  HIGHLY_CONCENTRATED
  UNKNOWN
}

enum PriceCompetitionLevel {
  LOW
  MODERATE
  HIGH
  VERY_HIGH
  UNKNOWN
}

enum ResellerViabilityBand {
  VERY_LOW
  LOW
  MODERATE
  HIGH
  VERY_HIGH
  UNKNOWN
}

enum ProductOppRiskType {
  WEAK_DEMAND
  DEMAND_DECLINE
  HIGH_COMPETITION
  MARKET_SATURATION
  LOW_MARGIN
  HIGH_PRICE_VOLATILITY
  SUPPLIER_CONCENTRATION
  LOGISTICS_COMPLEXITY
  SUPPLY_UNCERTAINTY
  INSUFFICIENT_DATA
  SPECIFICATION_AMBIGUITY
  SEASONALITY_RISK
  PRICE_COMPRESSION
  HIGH_LANDED_COST
}

enum ProductOppStatus {
  DETECTED
  VALIDATED
  WATCH
  ACTIONABLE
  DISMISSED
  EXPIRED
}

enum OpportunityConfidenceBand {
  HIGH
  MEDIUM
  LOW
  INSUFFICIENT_DATA
}

enum DataCompletenessBand {
  HIGH
  MODERATE
  LOW
  VERY_LOW
  UNKNOWN
}

// ─── Competitor Observation ──────────────────────────────────────────────────
// Observed competing product/listing. Immutable analytical record.

model CompetitorObservation {
  id                      String   @id @default(cuid())
  tenantId                String
  productId               String
  competitorName          String?
  competitorProductName   String?
  sourceType              String // SUPPLIER_QUOTE | MARKETPLACE_LISTING | SELLER_LISTING | MANUAL | IMPORT_RECORD
  sourceUrl               String?
  market                  String? // e.g. "alibaba", "daraz", "wholesale_dhaka"
  country                 String? // ISO 3166-1 alpha-2
  sellingPrice            Float?
  currency                String? // ISO 4217
  priceBasis              String? // UNIT | PACK | WHOLESALE | RETAIL
  rating                  Float?
  reviewCount             Int?
  availability            String? // IN_STOCK | OUT_OF_STOCK | LIMITED | UNKNOWN
  observedAt              DateTime
  evidenceId              String? // Phase 6 Evidence ID (not FK)
  contentHash             String // SHA-256 for deduplication
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant                  Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, productId, sourceType, contentHash])
  @@index([tenantId])
  @@index([productId])
  @@index([sourceType])
  @@index([market])
  @@index([country])
  @@index([observedAt])
  @@index([contentHash])
  @@map("competitor_observations")
}

// ─── Competitor Snapshot ─────────────────────────────────────────────────────
// Aggregated competition state for a product at a point in time.

model CompetitorSnapshot {
  id                      String              @id @default(cuid())
  tenantId                String
  productId               String
  observationCount        Int                 @default(0)
  uniqueCompetitorCount   Int                 @default(0)
  activeCompetitorCount   Int                 @default(0)
  minPrice                Float?
  maxPrice                Float?
  medianPrice             Float?
  priceSpread             Float?
  marketConcentration     Float? // HHI index if market share data exists
  competitionLevel        CompetitionLevel    @default(UNKNOWN)
  priceCompetitionLevel   PriceCompetitionLevel @default(UNKNOWN)
  snapshotDate            DateTime
  confidence              Float               @default(0)
  completeness            Float               @default(0)
  contentHash             String // SHA-256 of canonical inputs
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  tenant                  Tenant              @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, productId, snapshotDate, contentHash])
  @@index([tenantId])
  @@index([productId])
  @@index([snapshotDate])
  @@index([competitionLevel])
  @@index([contentHash])
  @@map("competitor_snapshots")
}

// ─── Demand Opportunity Snapshot ─────────────────────────────────────────────
// References Phase 7 demand intelligence. Does not duplicate raw demand data.

model DemandOpportunitySnapshot {
  id                String          @id @default(cuid())
  tenantId          String
  productId         String
  demandLevel       String? // HIGH | MODERATE | LOW | UNKNOWN
  demandMomentum    DemandMomentum  @default(UNKNOWN)
  searchGrowth      Float?
  seasonality       Float?
  trendStrength     Float?
  observationCount  Int             @default(0)
  confidence        Float           @default(0)
  completeness      Float           @default(0)
  snapshotDate      DateTime
  contentHash       String // SHA-256 of canonical inputs
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tenant            Tenant          @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, productId, snapshotDate, contentHash])
  @@index([tenantId])
  @@index([productId])
  @@index([snapshotDate])
  @@index([demandMomentum])
  @@index([contentHash])
  @@map("demand_opportunity_snapshots")
}

// ─── Product Opportunity Signal ──────────────────────────────────────────────
// One objective opportunity signal. No hidden recommendations.

model ProductOppSignal {
  id                  String                @id @default(cuid())
  tenantId            String
  productId           String
  signalType          ProductOppSignalType
  direction           String // POSITIVE | NEGATIVE | NEUTRAL | UNKNOWN
  magnitude           Float? // 0.0–1.0 strength of signal
  evidence            String // human-readable explanation
  sourceReferences    Json    @default("[]") // array of source IDs
  detectedAt          DateTime
  contentHash         String // SHA-256 of canonical inputs
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  tenant              Tenant                @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, productId, signalType, contentHash])
  @@index([tenantId])
  @@index([productId])
  @@index([signalType])
  @@index([direction])
  @@index([detectedAt])
  @@index([contentHash])
  @@map("product_opp_signals")
}

// ─── Product Opportunity Risk ────────────────────────────────────────────────
// One opportunity risk. Each risk has severity, trigger, and affected dimension.

model ProductOppRisk {
  id                    String              @id @default(cuid())
  tenantId              String
  productId             String
  riskType              ProductOppRiskType
  severity              String // LOW | MODERATE | HIGH | CRITICAL
  trigger               String // what triggered this risk
  affectedDimension     String // DEMAND | COMPETITION | SUPPLY | LOGISTICS | PRICING | DATA
  evidenceReferences    Json    @default("[]") // array of evidence IDs
  detectedAt            DateTime
  contentHash           String // SHA-256 of canonical inputs
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  tenant                Tenant              @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, productId, riskType, contentHash])
  @@index([tenantId])
  @@index([productId])
  @@index([riskType])
  @@index([severity])
  @@index([detectedAt])
  @@index([contentHash])
  @@map("product_opp_risks")
}

// ─── Reseller Viability Assessment ───────────────────────────────────────────
// Central analytical object. Contains independent dimensions, not a single score.
// Immutable snapshot — new assessments create new records with incremented version.

model ResellerViabilityAssessment {
  id                        String                    @id @default(cuid())
  tenantId                  String
  productId                 String
  
  // Demand metrics (from Phase 7)
  demandLevel               String? // HIGH | MODERATE | LOW | UNKNOWN
  demandMomentum            DemandMomentum            @default(UNKNOWN)
  demandConfidence          Float                     @default(0)
  
  // Competition metrics
  competitionLevel          CompetitionLevel          @default(UNKNOWN)
  competitionStructure      CompetitionStructure      @default(UNKNOWN)
  uniqueCompetitors         Int?
  activeListings            Int?
  competitionConfidence     Float                     @default(0)
  
  // Supply metrics (from Phase 9)
  supplierCount             Int?
  supplierDiversity         String? // HIGH | MODERATE | LOW | UNKNOWN
  supplierConcentration     SupplierConcentrationLevel @default(UNKNOWN)
  supplyConfidence          Float                     @default(0)
  
  // Logistics metrics (from Phase 10)
  routeCount                Int?
  logisticsComplexity       String? // HIGH | MODERATE | LOW | UNKNOWN
  logisticsConfidence       Float                     @default(0)
  
  // Pricing metrics (from Phase 11)
  unitLandedCost            Float?
  marketPriceMin            Float?
  marketPriceMax            Float?
  marketPriceMedian         Float?
  grossMarginMin            Float?
  grossMarginMax            Float?
  pricingConfidence         Float                     @default(0)
  
  // Market saturation
  marketSaturation          MarketSaturationLevel     @default(UNKNOWN)
  priceCompression          Boolean                   @default(false)
  
  // Computed scores (deterministic, from engine)
  opportunityScore          Float                     @default(0)
  viabilityScore            Float                     @default(0)
  
  // Overall dimensions
  dataCompleteness          DataCompletenessBand      @default(UNKNOWN)
  commercialRisk            String? // HIGH | MODERATE | LOW | UNKNOWN
  operationalRisk           String? // HIGH | MODERATE | LOW | UNKNOWN
  
  // Status
  status                    ProductOppStatus          @default(DETECTED)
  
  // Provenance
  algorithmVersion          String                    @default("OPPORTUNITY_ALGORITHM_V1")
  inputHash                 String // SHA-256 of canonical inputs
  contentHash               String // SHA-256 of full output
  signalIds                 Json                      @default("[]") // ProductOppSignal IDs
  riskIds                   Json                      @default("[]") // ProductOppRisk IDs
  competitorSnapshotId      String? // CompetitorSnapshot ID used
  demandSnapshotId          String? // DemandOpportunitySnapshot ID used
  version                   Int                       @default(1)
  calculatedAt              DateTime                  @default(now())
  validFrom                 DateTime?
  validTo                   DateTime?
  
  // Relationships
  tenant                    Tenant                    @relation(fields: [tenantId], references: [id])
  
  @@unique([tenantId, productId, version])
  @@index([tenantId])
  @@index([productId])
  @@index([status])
  @@index([opportunityScore])
  @@index([viabilityScore])
  @@index([inputHash])
  @@index([contentHash])
  @@index([calculatedAt])
  @@index([version])
  @@map("reseller_viability_assessments")
}

// =============================================================================
// PHASE 13 — Supplier Discovery, Sourcing & Procurement Intelligence
// =============================================================================
// Supplier-product matching, evaluation, sourcing economics, procurement
// viability, contact evidence, constraints, and comparison snapshots.
// All assessments are tenant-scoped, versioned, and content-hashed.

model SupplierSourcingAssessment {
  id                    String   @id @default(cuid())
  tenantId              String
  productId             String
  supplierId            String

  // Match dimensions
  matchLevel            String   // no_match | weak | possible | strong | exact
  matchScore            Float    @default(0)
  matchedAttributes     Json     @default("[]")
  unmatchedAttributes   Json     @default("[]")

  // Sourcing dimensions
  sourcingLevel         String   // unavailable | weak | possible | strong | preferred
  sourcingScore         Float    @default(0)

  // Viability dimensions
  viabilityLevel        String   // not_viable | weak | conditional | viable | strong
  viabilityScore        Float    @default(0)

  // Confidence & completeness
  confidence            Float    @default(0)
  completeness          Float    @default(0)

  // Commercial metrics
  capitalRequirement    Float?   // MOQ * unit price
  estimatedLeadTimeDays Int?     // supplier prep + logistics transit
  inventoryExposure     Float?   // MOQ coverage in months

  // Explanations & evidence
  explanations          Json     @default("[]")
  evidenceReferences    Json     @default("[]")

  // Provenance
  inputHash             String   // SHA-256 of canonical inputs
  contentHash           String   // SHA-256 of full output
  engineVersion         String   @default("phase13-v1")
  version               Int      @default(1)
  status                String   @default("DETECTED") // DETECTED | ACTIVE | EXPIRED
  calculatedAt          DateTime @default(now())
  validFrom             DateTime?
  validTo               DateTime?

  // Relationships
  tenant                Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, productId, supplierId, version])
  @@index([tenantId])
  @@index([productId])
  @@index([supplierId])
  @@index([status])
  @@index([matchLevel])
  @@index([sourcingLevel])
  @@index([viabilityLevel])
  @@index([inputHash])
  @@index([contentHash])
  @@index([calculatedAt])
  @@index([version])
  @@map("supplier_sourcing_assessments")
}

model SupplierProductMatch {
  id                  String   @id @default(cuid())
  tenantId            String
  productId           String
  supplierId          String

  matchLevel          String   // no_match | weak | possible | strong | exact
  matchScore          Float    @default(0)
  matchedAttributes   Json     @default("[]")
  unmatchedAttributes Json     @default("[]")
  evidenceConfidence  Float    @default(0)
  explanations        Json     @default("[]")

  contentHash         String
  engineVersion       String   @default("phase13-v1")
  calculatedAt        DateTime @default(now())

  // Relationships
  tenant              Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, productId, supplierId, contentHash])
  @@index([tenantId])
  @@index([productId])
  @@index([supplierId])
  @@index([matchLevel])
  @@map("supplier_product_matches")
}

model SourcingOptionRecord {
  id                         String   @id @default(cuid())
  tenantId                   String
  productId                  String
  supplierId                 String
  assessmentId               String?

  // Commercial terms
  sourcePrice                Float?
  currency                   String?
  moq                        Int?
  leadTimeDays               Int?
  quantityBreaks             Json     @default("[]")
  paymentTerms               String?

  // Calculated metrics
  estimatedLandedCost        Float?
  estimatedInitialInventoryCost Float?
  moqCoverageMonths          Float?   // MOQ / estimated monthly demand

  // Scoring
  sourcingLevel              String   // unavailable | weak | possible | strong | preferred
  sourcingScore              Float    @default(0)
  explanations               Json     @default("[]")

  contentHash                String
  engineVersion              String   @default("phase13-v1")
  calculatedAt               DateTime @default(now())

  // Relationships
  tenant                     Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, productId, supplierId, contentHash])
  @@index([tenantId])
  @@index([productId])
  @@index([supplierId])
  @@index([sourcingLevel])
  @@map("sourcing_option_records")
}

model ProcurementViabilityRecord {
  id                    String   @id @default(cuid())
  tenantId              String
  productId             String
  supplierId            String
  assessmentId          String?

  // Viability scoring
  viabilityLevel        String   // not_viable | weak | conditional | viable | strong
  viabilityScore        Float    @default(0)
  confidence            Float    @default(0)

  // Commercial metrics
  capitalRequirement    Float?
  estimatedLeadTimeDays Int?
  inventoryExposure     Float?

  // Dimension scores (12 dimensions)
  dimensionScores       Json     @default("{}")
  explanations          Json     @default("[]")

  contentHash           String
  engineVersion         String   @default("phase13-v1")
  calculatedAt          DateTime @default(now())

  // Relationships
  tenant                Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, productId, supplierId, contentHash])
  @@index([tenantId])
  @@index([productId])
  @@index([supplierId])
  @@index([viabilityLevel])
  @@map("procurement_viability_records")
}

model SupplierContactEvidence {
  id            String   @id @default(cuid())
  tenantId      String
  supplierId    String

  contactType   String   // website | email | phone | whatsapp | wechat | address | marketplace | other
  contactValue  String
  sourceId      String?
  evidenceId    String?
  confidence    Float    @default(0)

  contentHash   String
  observedAt    DateTime @default(now())

  // Relationships
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, supplierId, contactType, contactValue, contentHash])
  @@index([tenantId])
  @@index([supplierId])
  @@map("supplier_contact_evidence")
}

model SourcingConstraintRecord {
  id              String   @id @default(cuid())
  tenantId        String
  productId       String
  supplierId      String
  assessmentId    String?

  constraintType  String   // high_moq | unknown_moq | high_capital_requirement | unknown_price | etc.
  severity        String   // low | medium | high | critical
  value           String?  // stringified numeric or descriptive value
  explanation     String
  evidenceRefs    Json     @default("[]")

  contentHash     String
  detectedAt      DateTime @default(now())

  // Relationships
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, productId, supplierId, constraintType, contentHash])
  @@index([tenantId])
  @@index([productId])
  @@index([supplierId])
  @@index([constraintType])
  @@index([severity])
  @@map("sourcing_constraint_records")
}

model SupplierComparisonSnapshot {
  id                String   @id @default(cuid())
  tenantId          String
  productId         String

  supplierCount     Int
  comparisonFactors Json     @default("{}")
  ranking           Json     @default("[]")
  explanations      Json     @default("[]")

  contentHash       String
  engineVersion     String   @default("phase13-v1")
  snapshotDate      DateTime @default(now())

  // Relationships
  tenant            Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, productId, contentHash])
  @@index([tenantId])
  @@index([productId])
  @@index([snapshotDate])
  @@map("supplier_comparison_snapshots")
}

// =============================================================================
// PHASE 14 — AI RESEARCH & REASONING ENGINE
// =============================================================================
// Structured research and reasoning layer above the deterministic intelligence
// engines. Performs evidence-backed multi-step research, question decomposition,
// contradiction detection, hypothesis evaluation, and research-gap identification.
//
// Key invariants:
// - Evidence-first: every assertion traceable to evidence or structured intelligence
// - Deterministic engines remain source of truth for calculations/scores
// - AI reasoning consumes deterministic values, never reinvents them
// - Tenant isolation on every persisted artifact
// - Bounded research loops with configurable limits
// - Schema-validated AI output — no raw model output persisted as intelligence
// - Auditable reasoning trace with structured metadata
// =============================================================================

// ─── Phase 14 Enums ──────────────────────────────────────────────────────────

enum ResearchRequestStatus {
  QUEUED
  PLANNING
  RESEARCHING
  ANALYZING
  SYNTHESIZING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum ResearchQuestionType {
  IDENTITY
  SUPPLIER
  PRICING
  DEMAND
  LOGISTICS
  COMPETITION
  REGULATORY
  FEASIBILITY
  COMPARISON
  GENERAL
}

enum ResearchEvidenceQuality {
  HIGH
  MEDIUM
  LOW
  UNVERIFIED
}

enum ResearchHypothesisStatus {
  SUPPORTED
  PARTIALLY_SUPPORTED
  UNCERTAIN
  CONTRADICTED
  INSUFFICIENT_EVIDENCE
}

enum ResearchTemporalClassification {
  CURRENT
  RECENT
  HISTORICAL
  STALE
  UNKNOWN
}

// ─── Research Request ────────────────────────────────────────────────────────
// Central research request object. Tracks the full research lifecycle.

model ResearchRequest {
  id                    String                @id @default(cuid())
  tenantId              String
  userId                String?

  // Question
  question              String
  questionType          ResearchQuestionType  @default(GENERAL)
  productId             String?
  market                String?
  country               String?
  timePeriodStart       DateTime?
  timePeriodEnd         DateTime?
  researchObjective     String?
  constraints           Json                  @default("[]")
  requiredEvidenceQuality ResearchEvidenceQuality @default(MEDIUM)
  requestedDepth        String                @default("standard") // brief | standard | deep
  requestedOutputFormat String                @default("structured")

  // Status
  status                ResearchRequestStatus @default(QUEUED)
  priority              Int                   @default(5) // 1=highest, 10=lowest

  // Research plan (generated by AI)
  researchPlan          Json?                 // { objectives, subquestions, evidenceTypes, priorities }
  planVersion           Int                   @default(0)

  // Execution tracking
  currentIteration      Int                   @default(0)
  maxIterations         Int                   @default(5)
  modelCallsMade        Int                   @default(0)
  maxModelCalls         Int                   @default(20)
  evidenceItemsConsidered Int                 @default(0)
  maxEvidenceItems      Int                   @default(50)
  subQuestionsGenerated Int                   @default(0)
  maxSubQuestions       Int                   @default(15)
  tokenUsageEstimated   Int                   @default(0)
  maxTokenUsage         Int                   @default(50000)
  startedAt             DateTime?
  completedAt           DateTime?
  failedAt              DateTime?
  cancelledAt           DateTime?
  failureReason         String?
  executionDurationMs   Int?

  // Provider metadata
  providerName          String?
  providerModel         String?
  promptVersion         String                @default("research-v1")

  // Quality
  overallConfidence     Float                 @default(0)
  completenessScore     Float                 @default(0)

  // Provenance
  contentHash           String
  inputHash             String
  algorithmVersion      String                @default("RESEARCH_ALGORITHM_V1")
  cacheKey              String?

  // Timestamps
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  // Relationships
  tenant                Tenant                @relation(fields: [tenantId], references: [id])
  subQuestions          ResearchSubQuestion[]
  evidenceItems         ResearchEvidenceItem[]
  contradictions        ResearchContradiction[]
  hypotheses            ResearchHypothesis[]
  gaps                  ResearchGap[]
  results               ResearchResult[]

  @@index([tenantId])
  @@index([status])
  @@index([productId])
  @@index([questionType])
  @@index([inputHash])
  @@index([cacheKey])
  @@index([createdAt])
  @@map("research_requests")
}

// ─── Research Sub-Question ───────────────────────────────────────────────────
// A decomposed sub-question from the research plan.

model ResearchSubQuestion {
  id                String                  @id @default(cuid())
  tenantId          String
  requestId         String
  parentQuestionId  String?                 // for nested decomposition
  sequence          Int                     // ordering in research plan
  question          String
  questionType      ResearchQuestionType    @default(GENERAL)
  priority          Int                     @default(5)

  // Status
  status            String                  @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | SKIPPED | FAILED
  completedAt       DateTime?

  // Evidence found
  evidenceFound     Int                     @default(0)
  evidenceQuality   ResearchEvidenceQuality @default(UNVERIFIED)

  // Answer
  answer            String?                 // structured answer text
  answerConfidence  Float                   @default(0)
  answerBasis       Json                    @default("{}") // which evidence supports this answer

  // Dependencies
  dependsOn         Json                    @default("[]") // other sub-question IDs
  isDependencyMet   Boolean                 @default(false)

  // Provenance
  contentHash       String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  // Relationships
  tenant            Tenant                  @relation(fields: [tenantId], references: [id])
  request           ResearchRequest         @relation(fields: [requestId], references: [id])

  @@index([tenantId])
  @@index([requestId])
  @@index([status])
  @@index([contentHash])
  @@map("research_sub_questions")
}

// ─── Research Evidence Item ──────────────────────────────────────────────────
// One piece of evidence considered during research. Links to existing Evidence model.

model ResearchEvidenceItem {
  id                    String                      @id @default(cuid())
  tenantId              String
  requestId             String
  subQuestionId         String?

  // Evidence reference (links to Phase 6 Evidence where possible)
  evidenceId            String?                     // Phase 6 Evidence ID
  sourceType            String                      // EXISTING_EVIDENCE | INTELLIGENCE_RESULT | AI_INFERENCE | MANUAL
  sourceEntity          String?                     // e.g. "demand_signal", "pricing_assessment", "supplier_assessment"
  sourceEntityId        String?                     // ID of the source entity

  // Content
  title                 String
  description           String
  extractedValue        Json?
  valueType             String                      // string | number | boolean | json | currency | date

  // Quality assessment
  quality               ResearchEvidenceQuality     @default(UNVERIFIED)
  confidence            Float                       @default(0)
  sourceIndependence    Boolean                     @default(false)

  // Temporal
  observedAt            DateTime?
  temporalClassification ResearchTemporalClassification @default(UNKNOWN)
  freshness             String                      // live | fresh | aging | stale | unknown

  // Relevance
  relevanceScore        Float                       @default(0) // 0.0–1.0
  relevanceBasis        Json                        @default("{}")
  wasUsed               Boolean                     @default(true)
  rejectionReason       String?                     // if wasUsed = false

  // Provenance
  contentHash           String
  createdAt             DateTime                    @default(now())

  // Relationships
  tenant                Tenant                      @relation(fields: [tenantId], references: [id])
  request               ResearchRequest             @relation(fields: [requestId], references: [id])

  @@index([tenantId])
  @@index([requestId])
  @@index([subQuestionId])
  @@index([evidenceId])
  @@index([quality])
  @@index([contentHash])
  @@map("research_evidence_items")
}

// ─── Research Contradiction ──────────────────────────────────────────────────
// A detected contradiction between evidence items.

model ResearchContradiction {
  id                String    @id @default(cuid())
  tenantId          String
  requestId         String

  // What contradicts
  subject           String    // e.g. "MOQ", "supplier_price", "shipping_time"
  description       String
  severity          String    // low | medium | high | critical

  // Conflicting evidence
  evidenceItemIds   Json      @default("[]") // ResearchEvidenceItem IDs
  conflictingValues Json      // { source: value, source: value }

  // Resolution
  resolutionStatus  String    @default("OPEN") // OPEN | EXPLAINED | UNRESOLVABLE
  explanation       String?
  resolutionRequires String?  // e.g. "Confirm directly with supplier"

  // Provenance
  contentHash       String
  detectedAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())

  // Relationships
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  request           ResearchRequest @relation(fields: [requestId], references: [id])

  @@index([tenantId])
  @@index([requestId])
  @@index([severity])
  @@index([contentHash])
  @@map("research_contradictions")
}

// ─── Research Hypothesis ─────────────────────────────────────────────────────
// A hypothesis generated and evaluated during research.

model ResearchHypothesis {
  id                    String                      @id @default(cuid())
  tenantId              String
  requestId             String

  // Hypothesis
  statement             String
  hypothesisType        String                      // feasibility | viability | risk | opportunity | identity

  // Evaluation
  status                ResearchHypothesisStatus
  supportingEvidenceIds Json                        @default("[]")
  contradictingEvidenceIds Json                     @default("[]")
  unknowns              Json                        @default("[]")
  requiredAdditionalEvidence Json                   @default("[]")

  // Confidence
  confidence            Float                       @default(0)
  confidenceBasis       Json                        @default("{}")

  // Provenance
  contentHash           String
  evaluatedAt           DateTime                    @default(now())
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  // Relationships
  tenant                Tenant                      @relation(fields: [tenantId], references: [id])
  request               ResearchRequest             @relation(fields: [requestId], references: [id])

  @@index([tenantId])
  @@index([requestId])
  @@index([status])
  @@index([contentHash])
  @@map("research_hypotheses")
}

// ─── Research Gap ────────────────────────────────────────────────────────────
// An identified gap in the available evidence.

model ResearchGap {
  id                String    @id @default(cuid())
  tenantId          String
  requestId         String
  subQuestionId     String?

  // Gap description
  description       String
  affectedDimension String    // e.g. "supplier_price", "moq", "freight_cost", "demand"
  severity          String    // low | medium | high | critical

  // What would fill this gap
  requiredEvidenceType String?
  suggestedSource     String?
  isBlocking          Boolean @default(false) // whether this gap blocks conclusions

  // Provenance
  contentHash       String
  detectedAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  // Relationships
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  request           ResearchRequest @relation(fields: [requestId], references: [id])

  @@index([tenantId])
  @@index([requestId])
  @@index([severity])
  @@index([contentHash])
  @@map("research_gaps")
}

// ─── Research Result ─────────────────────────────────────────────────────────
// The final structured synthesis of a research request.

model ResearchResult {
  id                    String    @id @default(cuid())
  tenantId              String
  requestId             String

  // Synthesis
  summary               String    // concise answer to the original question
  detailedFindings      Json      @default("{}") // structured findings by dimension
  conclusions           Json      @default("[]") // list of structured conclusions
  keyInsights           Json      @default("[]") // most important insights

  // Quality
  overallConfidence     Float     @default(0)
  completenessScore     Float     @default(0)
  limitations           Json      @default("[]") // known limitations of the research

  // Recommendations for further research
  furtherResearchNeeded Json      @default("[]")
  priorityActions       Json      @default("[]")

  // Statistics
  totalSubQuestions     Int       @default(0)
  completedSubQuestions Int       @default(0)
  totalEvidenceItems    Int       @default(0)
  highQualityEvidence   Int       @default(0)
  contradictionsFound   Int       @default(0)
  hypothesesEvaluated   Int       @default(0)
  gapsIdentified        Int       @default(0)
  researchIterations    Int       @default(0)

  // Provenance
  contentHash           String
  inputHash             String
  algorithmVersion      String    @default("RESEARCH_ALGORITHM_V1")
  generatedAt           DateTime  @default(now())
  createdAt             DateTime  @default(now())

  // Relationships
  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  request               ResearchRequest @relation(fields: [requestId], references: [id])

  @@index([tenantId])
  @@index([requestId])
  @@index([overallConfidence])
  @@index([contentHash])
  @@index([generatedAt])
  @@map("research_results")
}

// =============================================================================
// PHASE 15 — SUPPLIER OUTREACH / SOURCING INTELLIGENCE ENGINE
// =============================================================================
// Structured supplier engagement and sourcing workflow layer.
// Converts supplier intelligence (Phase 13) and research capabilities (Phase 14)
// into evidence-backed outreach, response capture, verification, qualification,
// and sourcing follow-up.
//
// Key invariants:
// - Supplier claims != verified facts
// - AI extraction != verification
// - Evidence is immutable / history-preserving
// - Human approval required before external communication
// - Deterministic state transitions
// - Idempotent jobs
// - Tenant isolation on every artifact
// - Complete provenance
// - No fabricated supplier information
// - No silent overwriting of existing intelligence
// =============================================================================

// ─── Phase 15 Enums ─────────────────────────────────────────────────────────

enum OutreachStatus {
  DRAFT
  READY
  APPROVED
  QUEUED
  SENT
  DELIVERED
  RESPONDED
  FOLLOW_UP_REQUIRED
  QUALIFICATION_REQUIRED
  QUALIFIED
  REJECTED
  CLOSED
}

enum OutreachChannel {
  EMAIL
  WHATSAPP
  MARKETPLACE
  WEB_FORM
  MANUAL
  OTHER
}

enum OutreachTemplateType {
  INITIAL_INQUIRY
  SUPPLIER_VERIFICATION
  LOGISTICS_INQUIRY
  FOLLOW_UP
  CUSTOM
}

enum ResponseVerificationState {
  EXTRACTED
  UNVERIFIED
  VERIFIED
  CONTRADICTED
  REQUIRES_CLARIFICATION
}

enum AuditActorType {
  USER
  SYSTEM
  AI
  WORKER
}

enum QualificationLevel {
  NOT_QUALIFIED
  WEAK
  CONDITIONAL
  QUALIFIED
  STRONG
}

// ─── Outreach Campaign ──────────────────────────────────────────────────────
// Groups outreach activities for a product/sourcing objective.

model OutreachCampaign {
  id                String   @id @default(cuid())
  tenantId          String
  productId         String
  title             String
  objective         String?
  targetMarket      String?
  requirements      Json     @default("{}")
  status            String   @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED | CANCELLED
  responseStats     Json     @default("{}")
  qualificationState String  @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])
  outreachs  Outreach[]

  @@index([tenantId])
  @@index([productId])
  @@index([status])
  @@map("outreach_campaigns")
}

// ─── Outreach ───────────────────────────────────────────────────────────────
// Individual supplier outreach with deterministic lifecycle.

model Outreach {
  id            String         @id @default(cuid())
  tenantId      String
  campaignId    String?
  supplierId    String
  productId     String
  status        OutreachStatus @default(DRAFT)
  channel       OutreachChannel @default(MANUAL)
  assignedTo    String?
  lastContactedAt DateTime?
  nextActionAt  DateTime?
  priority      Int            @default(5) // 1=highest, 10=lowest
  templateType  OutreachTemplateType?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant        Tenant                  @relation(fields: [tenantId], references: [id])
  campaign      OutreachCampaign?       @relation(fields: [campaignId], references: [id])
  supplier      Supplier                @relation(fields: [supplierId], references: [id])
  product       Product                 @relation(fields: [productId], references: [id])
  messages      OutreachMessage[]
  responses     OutreachResponse[]
  followups     OutreachFollowup[]
  qualifications OutreachQualification[]
  threadEvents  OutreachThreadEvent[]

  @@index([tenantId])
  @@index([campaignId])
  @@index([supplierId])
  @@index([productId])
  @@index([status])
  @@index([channel])
  @@index([nextActionAt])
  @@map("outreachs")
}

// ─── Outreach Message ───────────────────────────────────────────────────────
// Versioned message with human approval gate.

model OutreachMessage {
  id              String   @id @default(cuid())
  tenantId        String
  outreachId      String
  direction       String   // OUTBOUND | INBOUND
  channel         OutreachChannel
  subject         String?
  bodyText        String
  structuredBody  Json?
  templateType    OutreachTemplateType?
  aiGenerated     Boolean  @default(false)
  approvedBy      String?
  approvedAt      DateTime?
  sentAt          DateTime?
  deliveredAt     DateTime?
  contentHash     String
  idempotencyKey  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  outreach Outreach  @relation(fields: [outreachId], references: [id])
  responses OutreachResponse[]

  @@index([tenantId])
  @@index([outreachId])
  @@index([direction])
  @@index([contentHash])
  @@index([idempotencyKey])
  @@map("outreach_messages")
}

// ─── Outreach Response ──────────────────────────────────────────────────────
// Preserved original supplier response. Never destroyed when normalizing.

model OutreachResponse {
  id                String                    @id @default(cuid())
  tenantId          String
  outreachId        String
  messageId         String?
  rawBody           String
  rawChannel        OutreachChannel
  receivedAt        DateTime                  @default(now())
  contactPerson     String?
  contentHash       String
  verificationState ResponseVerificationState @default(EXTRACTED)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  tenant          Tenant                    @relation(fields: [tenantId], references: [id])
  outreach        Outreach                  @relation(fields: [outreachId], references: [id])
  message         OutreachMessage?          @relation(fields: [messageId], references: [id])
  extractedFields OutreachExtractedField[]

  @@index([tenantId])
  @@index([outreachId])
  @@index([contentHash])
  @@index([verificationState])
  @@map("outreach_responses")
}

// ─── Outreach Extracted Field ───────────────────────────────────────────────
// Structured field extracted from a supplier response via AI.

model OutreachExtractedField {
  id                      String                    @id @default(cuid())
  tenantId                String
  responseId              String
  fieldName               String
  fieldValue              String
  valueType               String                    @default("string") // string | number | boolean | currency | date
  verificationState       ResponseVerificationState @default(EXTRACTED)
  confidence              Float                     @default(0)
  contradictingEvidenceIds Json?                    @default("[]")
  contentHash             String
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  response OutreachResponse @relation(fields: [responseId], references: [id])

  @@index([tenantId])
  @@index([responseId])
  @@index([fieldName])
  @@index([verificationState])
  @@index([contentHash])
  @@map("outreach_extracted_fields")
}

// ─── Outreach Follow-up ─────────────────────────────────────────────────────
// Follow-up items with scheduling.

model OutreachFollowup {
  id             String   @id @default(cuid())
  tenantId       String
  outreachId     String
  followupType   String   // MISSING_INFO | CONTRADICTION | UNVERIFIED_CLAIM | DOCUMENTATION_REQUEST | PRICE_CLARIFICATION | SAMPLE_REQUEST
  subject        String
  description    String
  priority       Int      @default(5)
  dueAt          DateTime?
  completedAt    DateTime?
  followupCount  Int      @default(0)
  contentHash    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  outreach Outreach @relation(fields: [outreachId], references: [id])

  @@index([tenantId])
  @@index([outreachId])
  @@index([followupType])
  @@index([dueAt])
  @@index([contentHash])
  @@map("outreach_followups")
}

// ─── Outreach Qualification ─────────────────────────────────────────────────
// Dimension-based qualification record. Versioned.

model OutreachQualification {
  id                String            @id @default(cuid())
  tenantId          String
  outreachId        String
  qualificationLevel QualificationLevel
  score             Float             @default(0)
  confidence        Float             @default(0)
  dimensionScores   Json              @default("{}")
  explanations      Json              @default("[]")
  contentHash       String
  version           Int               @default(1)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  outreach Outreach @relation(fields: [outreachId], references: [id])

  @@unique([tenantId, outreachId, version])
  @@index([tenantId])
  @@index([outreachId])
  @@index([qualificationLevel])
  @@index([contentHash])
  @@index([version])
  @@map("outreach_qualifications")
}

// ─── Outreach Thread Event ──────────────────────────────────────────────────
// Persistent interaction timeline for an outreach.

model OutreachThreadEvent {
  id          String         @id @default(cuid())
  tenantId    String
  outreachId  String
  eventType   String         // MESSAGE_SENT | MESSAGE_RECEIVED | RESPONSE_RECORDED | FIELD_EXTRACTED | QUALIFICATION_CHANGED | FOLLOWUP_CREATED | STATUS_CHANGED | EVIDENCE_CREATED | RESEARCH_REQUESTED | NOTE_ADDED
  eventData   Json           @default("{}")
  actorType   AuditActorType
  actorId     String?
  createdAt   DateTime       @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  outreach Outreach @relation(fields: [outreachId], references: [id])

  @@index([tenantId])
  @@index([outreachId])
  @@index([eventType])
  @@index([createdAt])
  @@map("outreach_thread_events")
}

// ─── Outreach Audit Entry ───────────────────────────────────────────────────
// Audit trail for all significant outreach actions.

model OutreachAuditEntry {
  id            String         @id @default(cuid())
  tenantId      String
  outreachId    String?
  campaignId    String?
  action        String         // OUTREACH_CREATED | MESSAGE_CREATED | MESSAGE_EDITED | MESSAGE_APPROVED | MESSAGE_SENT | RESPONSE_RECEIVED | FIELD_EXTRACTED | FIELD_EDITED | QUALIFICATION_CHANGED | FOLLOWUP_CREATED | EVIDENCE_CREATED | STATUS_CHANGED | CAMPAIGN_CREATED
  actorType     AuditActorType
  actorId       String?
  previousState String?
  newState      String?
  metadata      Json?          @default("{}")
  createdAt     DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([outreachId])
  @@index([campaignId])
  @@index([action])
  @@index([createdAt])
  @@map("outreach_audit_entries")
}

// ─── Outreach Template ──────────────────────────────────────────────────────
// Reusable message templates for supplier outreach.

model OutreachTemplate {
  id              String               @id @default(cuid())
  tenantId        String
  templateType    OutreachTemplateType
  name            String
  subjectTemplate String?
  bodyTemplate    String
  questionSet     Json?                @default("{}")
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([templateType])
  @@index([isActive])
  @@map("outreach_templates")
}
