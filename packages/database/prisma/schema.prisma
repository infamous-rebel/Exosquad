enum PriceScenarioType {
  CONSERVATIVE
  BASE
  UPSIDE
  IMPORT_WHOLESALE
  IMPORT_RETAIL
  MARKETPLACE
  DISTRIBUTOR
  DIRECT_TO_CONSUMER
}

enum PricingRiskType {
  UNKNOWN_FREIGHT
  UNKNOWN_DUTY
  UNKNOWN_TAX
  UNKNOWN_CLEARING
  CURRENCY_UNCERTAINTY
  HIGH_LOGISTICS_COST
  SUPPLIER_PRICE_UNCERTAINTY
  INSUFFICIENT_PRICE_OBSERVATIONS
  LARGE_PRICE_SPREAD
  STALE_OBSERVATIONS
  RAPID_PRICE_CHANGE
  SPECIFICATION_INCONSISTENCY
  PACKAGE_SIZE_MISMATCH
